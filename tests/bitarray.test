    bitarray fromchars "ab\u0100"
} -result {character U+0100 at index 2 does not fit in width 8}
test conv-3.5 {fromchars width 16 rejects a character above 65535} -returnCodes error -body {
    bitarray fromchars "a\U0001F600" -width 16
} -result {character U+1F600 at index 1 does not fit in width 16}
