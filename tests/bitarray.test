    list [catch {bitarray fromchars a -width 1} r1] $r1 [catch {bitarray fromchars a -width 64} r2] $r2
} -result {1 {fromchars: -width must be 8, 16 or 32} 1 {fromchars: -width must be 8, 16 or 32}}
