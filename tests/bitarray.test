    list [bitarray fromchars "\u0000\u0001A"] [bitarray fromchars "\u0000\u0001A" -width 16] [bitarray fromchars "\u0001\u0000" -width 32]
} -result {{0 1 65} {0 1 65} {1 0}}
test conv-4.1 {tochars round trip, all widths} -body {
    set s "A\u00e9\u20ac\U0001F600z"; list [expr {[bitarray tochars [bitarray fromchars $s -width 32]] eq $s}] [expr {[bitarray tochars [bitarray fromchars "A\u00e9\u20ac" -width 16]] eq "A\u00e9\u20ac"}] [expr {[bitarray tochars [bitarray fromchars "Ae\u00ff"]] eq "Ae\u00ff"}]
} -result {1 1 1}
