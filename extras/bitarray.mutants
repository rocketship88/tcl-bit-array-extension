	    }
	}
    }
    return TCL_OK;
}

/* --------------------------- commands ----------------------------- */

/*
 * IsWord --
 *	True if the string form of OBJ is exactly the word W (used for the
 *	optional helper words "to", "..", "with" and "by").
 */
static int
IsWord(Tcl_Obj *obj, const char *w)
{
    Tcl_Size n;
    const char *s = Tcl_GetStringFromObj(obj, &n);

    return memcmp(s, w, (size_t)n) == 0;   // the same length and the same bytes                    /* P07 deleted:clause | CAUGHT by 4: fill-w.26 count-w.14 next-w.9 op-7.10 | IsWord matches a prefix | line 1263 */
}

static int
NeedBA(Tcl_Interp *interp, Tcl_Obj *obj, BitArr **bPtr)
{
    if (!ISBA(obj)) {   // an ordinary list of 0s and 1s is refused
	Tcl_SetObjResult(interp, Tcl_ObjPrintf("not a bitarray: \"%.40s\"",
		Tcl_GetString(obj)));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    *bPtr = GETREP(obj);
    return TCL_OK;
}

static int
ParseWidthArg(Tcl_Interp *interp, Tcl_Obj *obj, int *widthPtr,
	int *signedPtr)
{
    Tcl_WideInt w;

    if (Tcl_GetWideIntFromObj(NULL, obj, &w) != TCL_OK   // the nine widths: 1, 8, 16, 32, 64 and the negative ones
	    || (w != 1 && w != 8 && w != 32 && w != 64                                              /* W48 deleted:clause | CAUGHT by 34: bitop-1.3 bitop-1.4 range-2.1 rev-2.1 conv-2.7 conv-3.2 conv-3.5 conv-3.11 conv-4.1 conv-4.6 width-1.2 width-1.5 width-1.14 range-16.1 range-16.2 elem-1.4 elem-1.7 elem-1.8 elem-1.10 elem-1.11 bulk-16.1 bulk-16.2 bulk-w.2 bulk-w.3 diff-4.1 mem-1.1 signed-1.1 signed-1.19 lpop-1.10 cov-2.1 op-8.3 op-8.4 op-9.11 op-11.3 | width 16 rejected | line 1286 */
	    && w != -8 && w != -16 && w != -64)) {                                                  /* G24 deleted:clause | CAUGHT by 9: signed-1.1 signed-1.2 signed-1.3 signed-1.10 signed-1.16 lpop-1.10 op-8.3 op-9.11 op-11.3 | -32 not an accepted width | line 1287 */
	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		"bad width \"%s\": must be 1, 8, 16, 32, 64, -8, -16, -32 or -64"
		" (a minus sign means signed)", Tcl_GetString(obj)));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    *signedPtr = 0;   // a minus sign means signed                                                  /* G16 deleted:clause | CAUGHT by 30: signed-1.1 signed-1.2 signed-1.3 signed-1.5 signed-1.6 signed-1.7 signed-1.8 signed-1.9 signed-1.10 signed-1.11 signed-1.12 signed-1.14 signed-1.15 signed-1.16 signed-1.17 signed-1.18 signed-1.21 lpop-1.10 op-3.3 op-7.8 op-8.3 op-9.1 op-9.2 op-9.3 op-9.4 op-9.6 op-9.11 op-11.3 op-11.5 op-11.6 | -width -8 not taken as signed | line 1294 */
    *widthPtr = (int)w;                                                                             /* G25 deleted:clause | CAUGHT (crash rc=132 while running signed-1.2) + failed: signed-1.1 | width given with a sign kept negative | line 1295 */
    return TCL_OK;
}

/*
 * Scan the optional arguments of "new" and "newfrom" starting at objv[FROM]:
 * "-width W" anywhere, and (for "new" only) one bare VALUE.
 */
static int
ParseCreateArgs(Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[],
	Tcl_Size from, int allowValue, int *widthPtr, int *signedPtr,
	Tcl_Obj **valuePtr, const char *usage)
{
    Tcl_Size i;

    *widthPtr = 1;
    *signedPtr = 0;
    *valuePtr = NULL;
    for (i = from; i < objc; i++) {
	if (strcmp(Tcl_GetString(objv[i]), "-width") == 0) {
                                                                                                    /* W47 deleted:clause | CAUGHT (crash rc=139 while running width-1.8) | -width without argument not detected | line 1315-1318 */
                                                                                                    /* W47 (cont.) */
                                                                                                    /* W47 (cont.) */
	    if (ParseWidthArg(interp, objv[++i], widthPtr, signedPtr) != TCL_OK) {   // ++i: the width value is used up too
		return TCL_ERROR;
	    }
	} else if (allowValue && *valuePtr == NULL) {                                // the first other word is the VALUE (new only)
	    *valuePtr = objv[i];
	} else {
	    goto usageError;                                                         // a second value, or a value where none is allowed
	}
    }
    return TCL_OK;

  usageError:
    Tcl_WrongNumArgs(interp, 2, objv, usage);
    return TCL_ERROR;
}

/* ------------------- bitwise operations (0.6.0) -------------------- */

enum { BO_AND, BO_OR, BO_XOR, BO_ANDNOT, BO_NOT,   // the bitwise operations (BitOpWords)
       BO_LAND, BO_LOR, BO_LNOT,                 // the logical ones, only for "bitarray op" (OpValue)
       BO_EQ, BO_NE, BO_LT, BO_LE, BO_GT, BO_GE };   // the relational ones, only for "bitarray op" (RelValue)

/*
 * BitOpWords --
