    Tcl_ObjInternalRep ir;

    if (d == NULL) {                                           // a dup hook cannot report an error
        Tcl_Panic("bitarray: out of memory in dup");
    }
    memcpy(d->words, s->words, (size_t)(s->nwords > 1 ? s->nwords - 1 : s->nwords) * sizeof(uint64_t));
                                                                                                    /* M27 changed:+tokens | CAUGHT by 14: shift-1.1 shift-1.2 rev-2.1 shift-2.1 shift-2.2 diff-1.1 grow-1.3 diff-3.1 elem-1.9 elem-1.19 diff-4.1 diff-4.2 signed-1.14 lpop-1.10 | dup copies one word short | line 678 */
    ir.twoPtrValue.ptr1 = d;
    ir.twoPtrValue.ptr2 = NULL;
    Tcl_StoreInternalRep(copyPtr, &bitarrayType, &ir);
}

