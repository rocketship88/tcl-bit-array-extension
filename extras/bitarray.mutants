/*
 * IsArrow --
 *	True if OBJ is the word "<-".  A bitarray value is never the word, and
 *	asking for its string form would build a long string, so it is skipped.
 */
static int
IsArrow(Tcl_Obj *obj)
{
    return !ISBA(obj) && IsWord(obj, "<-");
}

static int
BitLenCompat(Tcl_Interp *interp, const char *name, const BitArr *x,
	const BitArr *y, int zero)
{
    if (x->len != y->len) {   // lengths must match unless -length zero                             /* B15 deleted:clause | CAUGHT by 8: bitop-1.4 bitop-2.7 op-4.1 op-7.5 op-8.5 op-9.8 op-10.4 op-11.1 | length check ignores -length zero | line 1429 || ALSO B16 deleted:clause | CAUGHT by 12: bitop-1.4 bitop-2.7 bitop-3.2 bitop-3.8 op-4.1 op-4.2 op-7.5 op-8.5 op-9.8 op-10.4 op-11.1 op-12.4 | length check inverted => if (zero && x->len != y->len) { */
	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		"bitarray %s: arrays differ in length (%" TCL_SIZE_MODIFIER
		"d vs %" TCL_SIZE_MODIFIER "d); use -length zero to allow it",
		name, x->len, y->len));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    return TCL_OK;
}

static int
BitOpCompat(Tcl_Interp *interp, const char *name, const BitArr *x,
	const BitArr *y, int zero)
{
    if (SignedBits(x) != SignedBits(y)) {   // same width and the same signedness (64 and -64 are the same)
                                                                                                    /* B14 deleted:clause | CAUGHT by 5: bitop-3.1 signed-1.12 op-4.3 op-4.4 op-7.10 | width check dropped | line 1444 || ALSO G13 deleted:clause | CAUGHT by 1: signed-1.12 | bitwise: signed and unsigned arrays accepted together => if (x->width != y->width) { */
	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		"bitarray %s: arrays differ in width (%d vs %d)",
		name, SignedWidth(x), SignedWidth(y)));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    return BitLenCompat(interp, name, x, y, zero);
}

/*
