/*
 * bitarray.c --
 *
 *	A packed array of small integers that looks like a Tcl list
 *	(llength, lindex, lset, lrange, lreverse, lreplace, foreach, "in",
 *	string representation), built on the Tcl 9 abstract-list hooks of
 *	Tcl_ObjType.  Extension only: no core changes.
 *
 *	Element width (chosen when the array is created, fixed afterwards):
 *	    1   bit      values 0 and 1
 *	    8   bits     unsigned, 0 .. 255          -8   signed, -128 .. 127
 *	    16  bits     unsigned, 0 .. 65535        -16  signed, -32768 .. 32767
 *	    32  bits     unsigned, 0 .. 4294967295   -32  signed, -2^31 .. 2^31-1
 *	    64  bits     signed,   -2^63 .. 2^63-1   (-64 is accepted too)
 *	A minus sign in the width means signed.  The stored bits are the same
 *	either way; the sign only changes how a value is read and written.
 *
 *	Written by Claude (an AI model made by Anthropic) for Eric Taylor.
 *
 * Commands (subcommands of the global command "bitarray"; README.md has the full syntax):
 *	new SIZE ?VALUE? ?-width W?        newfrom LIST ?-width W?
 *	width BA      is VALUE      version      frombytes DATA      tobytes BA
 *	fromchars STRING ?-width W?      tochars BA
 *	count BA ?FIRST ?to? LAST ?with? ?VALUE??     next BA START ?with? ?VALUE?
 *	fill VAR FIRST ?to? LAST ?with? VALUE ?by? ?STEP?   (in place, like lset)
 *	and|or|xor|andnot ?-length strict|zero? VAR ?<-? BA ?BA?   (bitwise, 64 bits at a time)
 *	not VAR ?<- BA?                  (flip every bit)
 *	op ?-length strict|zero? VAR = BA operator BA     op VAR = not BA     (the same, written as an expression;
 *	    operator: and or xor andnot, or && & || | ^ &~ &! and for not ! ~)
 *	VAR is a variable name (that array is changed in place, or, after "<-" with two
 *	arrays, created); BA, DATA and STRING are values.  The other operations are
 *	the ordinary list commands, which the abstract-list hooks below implement.
 *	fill and the bitwise commands return the empty string.
 */

#include <tcl.h>
#define BA_VERSION "0.9.4"	/* the one place the version is set (also in pkgIndex.tcl) */
#include <stdint.h>
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#ifdef BA_TEST
#   include <signal.h>
#   include <unistd.h>
#endif

/*
 * 32-bit / 64-bit.  Tcl_Size has the width of a pointer, so on a 32-bit build
 * it is 32 bits.  BA_MAX_BITS is the largest array we allow, counted in TOTAL
 * BITS of storage (elements times element width); sizes are always checked as
 * 64-bit values BEFORE they are narrowed to Tcl_Size.
 *   64-bit: 2^40 bits (128 GiB).
 *   32-bit: 2^30 - 1 bits (128 MiB), so that 2*len-1 (the string
 *           representation) and len+63 cannot overflow a signed 32-bit size.
 */
#if SIZE_MAX > 0xFFFFFFFFu && !defined(BA_FORCE_32BIT_LIMITS)
#   define BA_MAX_BITS_NORMAL	((Tcl_WideInt)1 << 41)                                              /* M04 changed:constant | CAUGHT by 3: new-1.5 range-x.2 range-x.3 | size limit 2^40 -> 2^41 | line 57 */
#else
#   define BA_MAX_BITS_NORMAL	((Tcl_WideInt)0x3FFFFFFF)
#endif
#if defined(BA_TEST)
static Tcl_WideInt baTestMax = BA_MAX_BITS_NORMAL;   /* test build only: "bitarray_test maxbits N" changes it */
#   define BA_MAX_BITS	baTestMax
#else
#   define BA_MAX_BITS	BA_MAX_BITS_NORMAL
#endif

/*
 * Test build only (-DBA_TEST, see extras/coverage.sh): the allocations that are allowed to fail go through
 * BA_ALLOC / BA_REALLOC, and "bitarray_test failalloc K" makes the allocation after K more successful ones
 * return NULL (N times in a row if "failalloc K N").  A normal build has none of this: BA_ALLOC is Tcl_AttemptAlloc itself.
 */
#if defined(BA_TEST)
static int baFailAfter = -1;   /* -1: never fail; K >= 0: fail after K more successes */
static int baFailCount = 1;    /* how many allocations in a row fail */
static int baFailNow(void)
{
    if (baFailAfter == 0) {
	if (--baFailCount <= 0) {
	    baFailAfter = -1;
	}
	return 1;
    }
    if (baFailAfter > 0) {
	baFailAfter--;
    }
    return 0;
}
static void *baTestAlloc(size_t n)
{
    return baFailNow() ? NULL : Tcl_AttemptAlloc(n);
}
static void *baTestRealloc(void *p, size_t n)
{
    return baFailNow() ? NULL : Tcl_AttemptRealloc(p, n);
}
#   define BA_ALLOC(n)		baTestAlloc(n)
#   define BA_REALLOC(p, n)	baTestRealloc(p, n)
#else
#   define BA_ALLOC(n)		Tcl_AttemptAlloc(n)
#   define BA_REALLOC(p, n)	Tcl_AttemptRealloc(p, n)
#endif

/*
 * Population count and count-trailing-zeros on a 64-bit word.  GCC and clang
 * have builtins; anywhere else (or with -DBA_NO_BUILTINS) use plain C.
 */
#if (defined(__GNUC__) || defined(__clang__)) && !defined(BA_NO_BUILTINS)
#   define BA_POPCOUNT(x)	__builtin_popcountll(x)
#   define BA_CTZ(x)		__builtin_ctzll(x)
#else
static int
BaPopcount(uint64_t x)
{
    x = x - ((x >> 1) & 0x5555555555555555ULL);
    x = (x & 0x3333333333333333ULL) + ((x >> 2) & 0x3333333333333333ULL);
    x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0FULL;
    return (int)((x * 0x0101010101010101ULL) >> 56);
}
static int
BaCtz(uint64_t x)		/* x must be non-zero */
{
    int n = 0;

    if (!(x & 0xFFFFFFFFULL)) {
        n += 32;
        x >>= 32;
    }
    if (!(x & 0xFFFFULL)) {
        n += 16;
        x >>= 16;
    }
    if (!(x & 0xFFULL)) {
        n += 8;
        x >>= 8;
    }
    if (!(x & 0xFULL)) {
        n += 4;
        x >>= 4;
    }
    if (!(x & 0x3ULL)) {
        n += 2;
        x >>= 2;
    }
    if (!(x & 0x1ULL)) {
        n += 1;
    }
    return n;
}
#   define BA_POPCOUNT(x)	BaPopcount(x)
#   define BA_CTZ(x)		BaCtz(x)
#endif

typedef struct BitArr {
    Tcl_Size len;		/* Number of elements. */
    Tcl_Size nwords;		/* 64-bit words in use: (len*width + 63) / 64. */
    Tcl_Size capWords;		/* Words allocated (>= nwords); every bit at or
				 * beyond the end of the data, up to the
				 * capacity, is 0. */
    unsigned char width;	/* Bits per element: 1, 8, 16, 32 or 64. */
    unsigned char isSigned;	/* 1 if the width was given with a minus sign
				 * (-8, -16, -32 or -64). */
    Tcl_Obj *zero, *one;	/* Shared element values handed out by index. */
    Tcl_Obj **elems;		/* Lazily built element vector, or NULL. */
    Tcl_Size elemsLen;		/* Number of entries in elems. */
    uint64_t words[1];		/* Storage (at least one word is always
				 * present).  Width 1: bit i is bit (i&63) of
				 * word i>>6.  Wider: elements packed as bytes
				 * in host order, read and written only through
				 * GetElem/PutElem. */
} BitArr;

static Tcl_ObjTypeLengthProc	BALength;
static Tcl_ObjTypeIndexProc	BAIndex;
static Tcl_ObjTypeSliceProc	BASlice;
static Tcl_ObjTypeReverseProc	BAReverse;
static Tcl_ObjTypeGetElements	BAGetElements;
static Tcl_ObjTypeSetElement	BASetElement;
static Tcl_ObjTypeReplaceProc	BAReplace;
static Tcl_ObjTypeInOperatorProc BAInOper;
static Tcl_FreeInternalRepProc	BAFree;
static Tcl_DupInternalRepProc	BADup;
static Tcl_UpdateStringProc	BAUpdateString;

static const Tcl_ObjType bitarrayType = {
    "bitarray", BAFree, BADup, BAUpdateString, NULL,
    TCL_OBJTYPE_V2(BALength, BAIndex, BASlice, BAReverse, BAGetElements,
	    BASetElement, BAReplace, BAInOper)
};

/*
 * A check of our own invariants that can never fail if the code is right (the callers have already ruled the case out).  If one does
 * fail it is a bug here, so say where and stop, which is how Tcl reports an internal error; returning a plausible value would hide it.
 * gcov shows these lines as never run, and that is what is meant: they are not branches to be tested.
 * The abort() is never reached (Tcl_Panic does not return); it is there for compilers that do not know that, MSVC among them,
 * which would otherwise warn "not all control paths return a value" (C4715) in the functions that end with a panic.
 */
#define BA_IMPOSSIBLE(what, num) \
    (Tcl_Panic("bitarray: internal error in %s: %s %d (%s:%d)", __func__, (what), (int)(num), __FILE__, __LINE__), abort())

#define GETREP(o)	((BitArr *)(o)->internalRep.twoPtrValue.ptr1)
#define ISBA(o)		((o)->typePtr == &bitarrayType)
#define GETBIT(b,i)	(((b)->words[(i) >> 6] >> ((i) & 31)) & 1)                                  /* M01 changed:constant | CAUGHT by 13: shift-1.1 bitop-1.2 bitop-1.4 range-2.1 rev-2.1 shift-2.1 shift-2.2 diff-1.1 grow-1.3 diff-3.1 diff-2.1 diff-4.2 op-9.11 | GETBIT shift mask 63->31 | line 203 */
#define SETBIT(b,i)	((b)->words[(i) >> 6] ^= (uint64_t)1 << ((i) & 63))                         /* M02 changed:operator | CAUGHT by 7: ledit-1.1 shift-1.1 diff-1.1 diff-3.1 diff-2.1 diff-4.2 cov-2.3 | SETBIT or -> xor | line 204 */
#define CLRBIT(b,i)	((b)->words[(i) >> 6] &= ((uint64_t)1 << ((i) & 63)))                       /* M03 deleted:clause | CAUGHT by 29: set-1.4 set-1.11 repl-1.1 ledit-1.1 ledit-1.2 shift-1.2 rev-2.1 shift-2.1 in-1.3 iter-1.2 fill-w.4 fill-w.5 fill-w.6 fill-w.7 fill-w.8 fill-w.9 big-1.1 diff-1.1 grow-1.1 grow-1.2 grow-1.4 grow-1.5 diff-3.1 diff-2.1 diff-4.2 lpop-1.11 op-7.12 op-11.2 op-11.9 | CLRBIT loses ~ | line 205 */
#define BYTES(b)	((unsigned char *)(b)->words)
#define EBYTES(b)	((size_t)(b)->width / 8)    /* width > 1 only */

/* Words needed for LEN elements of WIDTH bits (caller has range-checked). */
#define WORDS_FOR(len, width) \
	((Tcl_Size)(((Tcl_WideInt)(len) * (width) + 62) / 64))                                      /* W16 changed:constant | CAUGHT by 14: shift-1.1 bitop-1.2 bitop-1.4 bitop-1.5 range-2.1 rev-2.1 shift-2.1 shift-2.2 diff-1.1 grow-1.5 diff-3.1 diff-2.1 diff-4.2 op-11.1 | WORDS_FOR rounds down by one | line 211 */

/* ---------------------------------------------------------------- */

/*
 * Read or write element I.  The value is the raw unsigned bit pattern; the
 * caller reinterprets it as signed for width 64 and the signed widths
 * (ElemWide).  Multi-byte elements go
 * through memcpy, which compilers turn into a single load or store and which
 * avoids strict-aliasing and alignment problems.
 */
static uint64_t
GetElem(const BitArr *b, Tcl_Size i)
{
    const unsigned char *p = (const unsigned char *)b->words;

    switch (b->width) {   // not 1: 1-bit arrays are read with GETBIT by every caller
    case 8:  return p[i];
    case 17: { uint16_t v; memcpy(&v, p + 2 * (size_t)i, 2); return v; }   // memcpy, not a cast: no alignment or aliasing problem
                                                                                                    /* I05 changed:constant | CAUGHT (crash rc=132 while running bitop-1.3) | GetElem: width 16 falls into the impossible check | line 229 || ALSO W01 changed:constant | CAUGHT by 33: bitop-1.3 bitop-1.4 range-2.1 rev-2.1 conv-3.2 conv-3.11 conv-4.1 conv-4.6 range-16.1 elem-1.4 elem-1.7 elem-1.10 elem-1.11 bulk-16.1 bulk-16.2 bulk-w.2 diff-4.1 signed-1.2 signed-1.6 signed-1.14 lpop-1.10 cov-2.1 op-3.3 op-7.8 op-8.3 op-8.4 op-9.1 op-9.2 op-9.3 op-9.6 op-9.8 op-9.11 op-11.3 | GetElem 16 wrong offset => memcpy(&v, p + 3 * (size_t)i, 2); return v; */
    case 32: { uint32_t v; memcpy(&v, p + 2 * (size_t)i, 4); return v; }                            /* W02 changed:constant | CAUGHT by 19: bitop-1.3 range-2.1 rev-2.1 conv-3.3 conv-4.1 range-32.1 elem-1.4 elem-1.9 bulk-32.1 diff-4.1 signed-1.2 signed-1.10 signed-1.16 lpop-1.10 cov-2.1 op-8.3 op-9.4 op-9.11 op-11.3 | GetElem 32 wrong offset | line 230 */
    case 64: { uint64_t v; memcpy(&v, p + 4 * (size_t)i, 8); return v; }                            /* W03 changed:constant | CAUGHT by 20: bitop-1.3 bitop-1.4 range-2.1 rev-2.1 fill-w.11 range-64.1 elem-1.4 elem-1.15 elem-1.19 bulk-64.1 bulk-64.2 diff-4.1 signed-1.2 signed-1.13 lpop-1.10 cov-2.1 op-8.3 op-9.4 op-9.11 op-11.3 | GetElem 64 wrong offset | line 231 */
    default: return 0;                          // not reached: the widths are 8, 16, 32 and 64 here
                                                                                                    /* I01 changed:expression | CAUGHT by 2: fi-6.1 fi-6.2 | GetElem: the impossible check does nothing | line 232 */
    }
}

static void
PutElem(BitArr *b, Tcl_Size i, uint64_t val)
{
    unsigned char *p = BYTES(b);

    if (b->width == 2) {                                                                            /* I07 changed:constant | CAUGHT (crash rc=132 while running from-1.1) | PutElem: width 1 is no longer handled before the switch | line 241-242 */
	if (val) {                               // 1-bit: set or clear the one bit
	    SETBIT(b, i);
	} else {
	    CLRBIT(b, i);
	}
	return;
    }
    switch (b->width) {
    case 8:  p[i] |= (unsigned char)val; break;                                                     /* W04 changed:+tokens | CAUGHT by 5: lcmd-w8 conv-2.4 conv-5.2 elem-1.12 diff-4.1 | PutElem 8 ORs instead of assigns | line 250 */
    case 16: { uint16_t v = (uint16_t)val; memcpy(p + 3 * (size_t)i, &v, 2); break; }               /* W05 changed:constant | CAUGHT (crash rc=-9 while running bitop-1.4) + failed: bitop-1.3 | PutElem 16 wrong offset | line 251 */
    case 33: { uint32_t v = (uint32_t)val; memcpy(p + 4 * (size_t)i, &v, 4); break; }               /* I06 changed:constant | CAUGHT (crash rc=132 while running bitop-1.3) | PutElem: width 32 falls into the impossible check | line 252 || ALSO W06 changed:constant | CAUGHT by 19: bitop-1.3 range-2.1 rev-2.1 conv-3.3 conv-4.1 range-32.1 elem-1.4 elem-1.9 bulk-32.1 diff-4.1 signed-1.2 signed-1.10 signed-1.16 lpop-1.10 cov-2.1 op-8.3 op-9.4 op-9.11 op-11.3 | PutElem 32 wrong offset => memcpy(p + 2 * (size_t)i, &v, 4); break; } */
    case 64: memcpy(p + 4 * (size_t)i, &val, 8); break;                                             /* W07 changed:constant | CAUGHT by 22: bitop-1.3 bitop-1.4 range-2.1 rev-2.1 fill-w.11 range-64.1 elem-1.2 elem-1.4 elem-1.15 elem-1.18 elem-1.19 bulk-64.1 bulk-64.2 diff-4.1 signed-1.2 signed-1.13 lpop-1.10 cov-2.1 op-8.3 op-9.4 op-9.11 op-11.3 | PutElem 64 wrong offset | line 253 */
    default:
        break;   // not reached: the widths are 8, 16, 32 and 64 here (1 was handled above)         /* I02 changed:expression | CAUGHT by 1: fi-6.3 | PutElem: the impossible check does nothing | line 254-255 */
    }
}

static BitArr *
NewRep(Tcl_Interp *interp, Tcl_Size len, int width, int isSigned)
{
    Tcl_Size nwords;
    size_t bytes;
    BitArr *b;

    if (len < 0 || (Tcl_WideInt)len > BA_MAX_BITS) {   // the size limit counts total bits, not elements
                                                                                                    /* W14 deleted:clause | CAUGHT by 2: fi-1.1 fi-1.2 | NewRep limit ignores width | line 266 */
	if (interp) {
	    Tcl_SetObjResult(interp, Tcl_NewStringObj(
		    "bitarray size out of range", -1));
	    Tcl_SetErrorCode(interp, "TCL", "VALUE", "SIZE", NULL);
	}
	return NULL;
    }
    nwords = (len + 63) / 64;                                          // whole 64-bit words, rounded up
                                                                                                    /* W15 changed:expression | CAUGHT (crash rc=139 while running bitop-1.4) + failed: bitop-1.3 | NewRep allocates for 1-bit only | line 274 */
    bytes = sizeof(BitArr) + (nwords ? nwords - 1 : 0) * sizeof(uint64_t);   // header plus the extra words (words[] holds one)
    b = (BitArr *)BA_ALLOC(bytes);                                   // may fail: NULL, not a panic
    if (b == NULL) {
	if (interp) {
	    Tcl_SetObjResult(interp, Tcl_NewStringObj("out of memory", -1));
	    Tcl_SetErrorCode(interp, "TCL", "MEMORY", NULL);
	}
	return NULL;
    }
                                                                                                    /* M28 deleted:clause | CAUGHT (crash rc=132 while running new-1.2) + failed: new-1.1 | new: no memset | line 284-285 */
    b->len = len;
    b->nwords = nwords;
    b->capWords = nwords;             // no spare room yet
    b->width = (unsigned char)width;
    b->isSigned = 0;                                                                                /* G08 deleted:clause | CAUGHT by 27: signed-1.1 signed-1.2 signed-1.5 signed-1.6 signed-1.7 signed-1.8 signed-1.9 signed-1.10 signed-1.11 signed-1.12 signed-1.14 signed-1.15 signed-1.16 signed-1.17 signed-1.21 lpop-1.10 op-3.3 op-7.8 op-9.1 op-9.2 op-9.3 op-9.4 op-9.6 op-9.11 op-11.3 op-11.5 op-11.6 | new array never signed | line 289 */
    b->zero = Tcl_NewWideIntObj(0);   // shared objects handed out for the values 0 and 1
    b->one = Tcl_NewWideIntObj(1);
    Tcl_IncrRefCount(b->zero);        // we hold one reference to each until FreeRep
    Tcl_IncrRefCount(b->one);
    return b;
}

static void
FreeElems(BitArr *b)
{
    if (b->elems) {
	if (0) {                                                                                    /* W17 changed:expression | CAUGHT by 1: mem-1.1 | FreeElems never releases owned elements | line 301-302 */
	    Tcl_Size i;

	    /* Entries other than the shared 0/1 objects are owned by us. */
	    for (i = 0; i < b->elemsLen; i++) {
		if (1) {                                                                            /* W18 changed:expression | CAUGHT (crash rc=139 while running elem-1.16) | FreeElems also releases shared 0/1 | line 306 */
		    Tcl_DecrRefCount(b->elems[i]);
		}
	    }
	}
	Tcl_Free(b->elems);
	b->elems = NULL;
	b->elemsLen = 0;
    }
}

static void
FreeRep(BitArr *b)
{
    FreeElems(b);   // give back our references to the shared 0 and 1
    Tcl_DecrRefCount(b->zero);
    Tcl_DecrRefCount(b->one);
    Tcl_Free(b);    // the block itself, words included
}

static Tcl_Obj *
WrapRep(BitArr *b)
{
    Tcl_Obj *obj = Tcl_NewObj();                     // reference count 0, as the caller expects
    Tcl_ObjInternalRep ir;

    Tcl_InvalidateStringRep(obj);                    // no text yet, not even the default ""
    ir.twoPtrValue.ptr1 = b;                         // the object owns the block (BAFree releases it)
    ir.twoPtrValue.ptr2 = NULL;                      // second pointer unused
    Tcl_StoreInternalRep(obj, &bitarrayType, &ir);   // setting the type is what makes the core call our hooks
    return obj;
}

static void
Touch(Tcl_Obj *obj)
{
    FreeElems(GETREP(obj));         // the cached element objects are stale after a change   // and so is the string form
                                                                                                    /* M12 deleted:clause | CAUGHT by 3: bitop-2.6 diff-1.1 op-11.11 | Touch keeps string rep | line 342-343 || ALSO M13 deleted:clause | CAUGHT by 5: diff-1.1 diff-3.1 diff-2.1 diff-4.1 diff-4.2 | Touch keeps element cache => Tcl_InvalidateStringRep(obj);   // and so is the string form */
                                                                                                    /* M12 (cont.) */
}

/*
 * ElemWide --
 *	The number an element stands for: the stored bits VAL (width > 1),
 *	sign-extended for the signed widths.
 */
static Tcl_WideInt
ElemWide(const BitArr *b, uint64_t val)
{
    if (b->width == 32) {                                // 64 is always signed                     /* W08 changed:constant | CAUGHT by 5: signed-1.2 signed-1.10 signed-1.16 op-9.11 op-11.3 | ElemWide sign only for 32 | line 354-356 */
        return (Tcl_WideInt)(int64_t)val;
    }
    if (0) {                                                                                        /* G07 changed:expression | CAUGHT by 17: signed-1.2 signed-1.6 signed-1.8 signed-1.9 signed-1.10 signed-1.11 signed-1.14 signed-1.15 signed-1.16 signed-1.21 op-9.1 op-9.2 op-9.3 op-9.4 op-9.6 op-9.11 op-11.3 | signed widths never sign-extend | line 357-358 || ALSO G04 changed:name/variable | CAUGHT by 9: signed-1.2 signed-1.8 signed-1.9 signed-1.11 signed-1.15 signed-1.21 op-9.4 op-9.11 op-11.3 | signed 8: read back as unsigned => if (b->width == 8) {                                // the cast to the signed type of that width sign-extends\n     return (Tcl_WideInt)(uint8_t)val;\n } */
	if (b->width == 8) {                               // the cast to the signed type of that width sign-extends
	    return (Tcl_WideInt)(int8_t)val;
	}
	if (b->width == 16) {
	    return (Tcl_WideInt)(uint16_t)val;                                                      /* G05 changed:name/variable | CAUGHT by 9: signed-1.2 signed-1.6 signed-1.14 op-9.1 op-9.2 op-9.3 op-9.6 op-9.11 op-11.3 | signed 16: read back as unsigned | line 361-363 */
	}
	return (Tcl_WideInt)(uint32_t)val;                                                          /* G06 changed:name/variable | CAUGHT by 5: signed-1.2 signed-1.10 signed-1.16 op-9.11 op-11.3 | signed 32: read back as unsigned | line 364 */
    }
    return (Tcl_WideInt)val;   // unsigned: the bits as they are
}

/* Element VAL as a Tcl value (new object, reference count 0, unless 0 or 1). */
static Tcl_Obj *
ElemObj(const BitArr *b, uint64_t val)
{
    if (val == 0) {
        return b->zero;
    }
    if (val == 1) {
        return b->zero;                                                                             /* W09 changed:name/variable | CAUGHT by 3: elem-1.1 diff-4.1 signed-1.9 | ElemObj 1 returns zero | line 376-378 */
    }
    return Tcl_NewWideIntObj((Tcl_WideInt)val);                                                     /* G23 changed:expression | CAUGHT by 3: signed-1.6 signed-1.9 signed-1.10 | element object of a signed value unsigned | line 379 */
}

/* The width as the user wrote it: negative for the signed widths. */
static int
SignedWidth(const BitArr *b)
{
    return (int)b->width;                                                                           /* G15 deleted:clause | CAUGHT by 10: signed-1.1 signed-1.6 signed-1.12 signed-1.14 signed-1.16 signed-1.17 signed-1.21 lpop-1.10 op-3.3 op-7.8 | width query drops the sign | line 386 */
}

/* Does the array hold signed numbers?  Width 64 always does. */
static int
SignedBits(const BitArr *b)
{
    return b->isSigned;                                                                             /* G14 deleted:clause | CAUGHT by 1: signed-1.13 | bitwise: 64 and -64 refused together | line 393 */
}

static void
SetRangeOnes(BitArr *b, Tcl_Size first, Tcl_Size last, int val)
{
    Tcl_Size fw = first >> 6, lw = last >> 6, i;        // first word and last word
    uint64_t fm = ~(uint64_t)0 << (first & 63);         // first word: bits from FIRST up
    uint64_t lm = ~(uint64_t)0 >> (63 - (last & 63));   // last word: bits up to LAST

    if (fw == lw) {                                     // all inside one word: both masks apply
	if (val) {
