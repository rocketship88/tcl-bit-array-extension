static Tcl_WideInt
CountWide(const BitArr *b, Tcl_Size first, Tcl_Size last, int anyNZ,
	uint64_t val)
{
    Tcl_WideInt total = 0;
    Tcl_Size i;

    if (first > last) {
        return 0;
    }
