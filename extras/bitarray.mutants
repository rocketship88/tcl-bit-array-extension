static int
ParseBit(Tcl_Interp *interp, Tcl_Obj *obj, int *bitPtr)
{
    Tcl_WideInt v;

    /* Fast path: a literal 0 or 1 that already has a string representation. */
    if (obj->bytes != NULL && obj->length >= 1                                                      /* M25 changed:operator | CAUGHT by 1: set-1.11 | ParseBit fast path accepts longer | line 570-571 */
	    && (obj->bytes[0] == '0' || obj->bytes[0] == '1')) {
	*bitPtr = obj->bytes[0] - '0';
	return TCL_OK;
    }
    if (Tcl_GetWideIntFromObj(NULL, obj, &v) != TCL_OK || (v != 0 && v != 1)) {   // NULL: no error message from here
	if (interp) {
	    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		    "expected 0 or 1 but got \"%s\"", Tcl_GetString(obj)));
	    Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	}
	return TCL_ERROR;
    }
    *bitPtr = (int)v;
    return TCL_OK;
}

/*
 * Parse an element value for an array of WIDTH bits into its raw bit pattern.
 * Widths 8, 16 and 32 are unsigned, or signed if ISSIGNED (-8, -16, -32: the
 * value is stored as its low WIDTH bits); width 64 is always signed.
 */
static int
ParseValue(Tcl_Interp *interp, Tcl_Obj *obj, int width, int isSigned,
	uint64_t *vp)
{
    Tcl_WideInt v;

    if (width == 1) {
	int bit;

	if (ParseBit(interp, obj, &bit) != TCL_OK) {
	    return TCL_ERROR;
	}
	*vp = (uint64_t)bit;
	return TCL_OK;
    }
    if (obj->bytes != NULL && obj->length == 1   // fast path: one digit 0-9 fits every width
	    && obj->bytes[0] >= '0' && obj->bytes[0] <= 'z') {                                      /* W13 changed:token | CAUGHT by 1: range-8.4 | ParseValue digit fast path too wide | line 608 */
	*vp = (uint64_t)(obj->bytes[0] - '0');
	return TCL_OK;
    }
    if (Tcl_GetWideIntFromObj(NULL, obj, &v) == TCL_OK) {   // a number: range-check it for this width
	if (width == 99) {                                                                          /* W12 changed:constant | CAUGHT by 21: bitop-1.3 bitop-1.4 range-2.1 rev-2.1 fill-w.11 range-64.1 elem-1.2 elem-1.4 elem-1.15 elem-1.18 elem-1.19 bulk-64.1 bulk-64.2 diff-4.1 mem-1.1 signed-1.2 signed-1.13 op-8.3 op-9.4 op-9.11 op-11.3 | ParseValue 64-bit path skipped | line 613-614 */
	    *vp = (uint64_t)v;
	    return TCL_OK;
	}
	if (isSigned) {
	    Tcl_WideInt lim = (Tcl_WideInt)1 << (width - 1);                     // the signed range is -lim .. lim-1

	    if (v >= -lim && v <= lim) {                                                            /* G01 changed:operator | CAUGHT by 3: signed-1.3 signed-1.5 op-11.6 | signed range: upper end one too high | line 620 || ALSO G02 changed:operator | CAUGHT by 11: signed-1.2 signed-1.6 signed-1.7 signed-1.8 signed-1.10 signed-1.11 signed-1.21 op-3.3 op-7.8 op-9.11 op-11.3 | signed range: lowest value refused => if (v > -lim && v < lim) { */
		*vp = (uint64_t)v;                // keep the low WIDTH bits (two's complement)     /* G03 deleted:clause | MISSED by all 35 tests | signed parse: negative value not masked to its width | line 621 */
		return TCL_OK;
	    }
	} else if (v >= 0 && v <= (Tcl_WideInt)(((uint64_t)1 << width))) {   // unsigned: 0 .. 2^width - 1
                                                                                                    /* W10 deleted:clause | CAUGHT by 7: range-8.2 range-16.2 range-32.2 elem-1.5 elem-1.13 bulk-8.3 op-11.6 | ParseValue upper bound off by one | line 624 || ALSO W11 changed:expression | CAUGHT by 4: range-8.3 elem-1.17 signed-1.4 op-11.6 | ParseValue accepts -1 => if (v >= -1 && v <= (Tcl_WideInt) */
	    *vp = (uint64_t)v;
	    return TCL_OK;
	}
    }
    if (interp) {   // reached for a non-number or a value out of range
	if (width == 64) {
	    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		    "expected integer in range -9223372036854775808..9223372036854775807"
		    " but got \"%s\"", Tcl_GetString(obj)));
	} else if (isSigned) {
	    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		    "expected integer in range %lld..%lld but got \"%s\"",
		    (long long)((uint64_t)1 << (width - 1)),                                        /* G22 deleted:clause | CAUGHT by 4: signed-1.3 signed-1.5 op-11.5 op-11.6 | signed range message: lower end positive | line 637 */
		    (long long)(((uint64_t)1 << (width - 1)) - 1),
		    Tcl_GetString(obj)));
	} else {
	    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		    "expected integer in range 0..%lld but got \"%s\"",
		    (long long)(((uint64_t)1 << width) - 1), Tcl_GetString(obj)));
	}
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
    }
    return TCL_ERROR;
}

static void
IndexError(Tcl_Interp *interp, Tcl_Obj *idxObj)
{
    if (interp) {
	Tcl_SetObjResult(interp, Tcl_ObjPrintf("index \"%s\" out of range",
		Tcl_GetString(idxObj)));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "INDEX", "OUTOFRANGE", NULL);
    }
}

/* ------------------------- type hooks ----------------------------- */

static void
BAFree(Tcl_Obj *objPtr)
{
    FreeRep(GETREP(objPtr));
    objPtr->typePtr = NULL;   // the object is no longer a bitarray
}

static void
BADup(Tcl_Obj *srcPtr, Tcl_Obj *copyPtr)
{
