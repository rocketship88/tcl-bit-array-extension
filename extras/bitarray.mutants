/*
 * ElemNonzero --
 *	True if element I of B is not 0.
 */
static int
ElemNonzero(const BitArr *b, Tcl_Size i)
{
    if (b->width == 1) {
	return (int)GETBIT(b, i);
    }
    return (GetElem(b, i) & 1) != 0;                                                                /* O33 changed:+tokens | CAUGHT by 2: op-8.2 op-8.8 | ElemNonzero: only the low bit of a wide element | line 1611 */
}

