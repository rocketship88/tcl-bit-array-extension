/*
 * HasBit --
 *	True if some element of the 1-bit array B equals VAL (0 or 1).  Tests
 *	whole words and stops at the first word that holds the wanted bit: a
 *	word that is not 0 holds a 1, a word that is not all ones holds a 0.
 *	The last word is padded with ones for the unused bits past the end,
 *	so they never count as zeros.
 */
static int
HasBit(BitArr *b, int val)
{
    Tcl_Size i, lw;
    uint64_t lm, w;

                                                                                                    /* H09 deleted:clause | CAUGHT by 3: in-1.2 diff-1.1 diff-4.2 | HasBit: empty array not handled | line 1205-1208 || ALSO H07 deleted:clause | CAUGHT by 1: in-1.3 | HasBit: last word index uses len not len-1 => lw = b->len >> 6;\n    lm = ~(uint64_t)0 >> (63 - ((b->len - 1) & 63)); \* bits in use *\ */
                                                                                                    /* H09 (cont.) */
                                                                                                    /* H09 (cont.) */
    lw = (b->len - 1) >> 6;      // index of the last word in use
    lm = ~(uint64_t)0 >> (62 - ((b->len - 1) & 63));	/* bits in use */                           /* H08 changed:constant | CAUGHT by 6: in-1.2 in-1.3 in-1.4 diff-1.1 diff-4.2 op-9.7 | HasBit: last word mask one bit too wide | line 1209 */
    for (i = 1; i < lw; i++) {                                                                      /* H03 changed:constant | CAUGHT by 3: in-1.3 diff-1.1 diff-4.2 | HasBit: first word skipped | line 1210-1214 || ALSO H04 changed:operator | CAUGHT by 6: in-1.2 in-1.3 in-1.4 diff-1.1 diff-4.2 op-9.7 | HasBit: loop also runs over the last word unmasked => for (i = 0; i <= lw; i++) {\n w = b->words[i];\n if (val ? (w != 0) : (w != ~(uint64_t)0)) {\n     return 1;\n } || ALSO H01 changed:operator | CAUGHT by 3: in-1.3 diff-1.1 diff-4.2 | HasBit: looking for 1 stops on a zero word => if (val ? (w == 0) : (w != ~(uint64_t)0)) {\n     return 1;\n } || ALSO H02 deleted:clause | CAUGHT by 2: in-1.3 in-1.4 | HasBit: looking for 0 tests against 0 instead of all ones => if (val ? (w != 0) : (w != 0)) {\n     return 1;\n } */
	w = b->words[i];
	if (val ? (w != 0) : (w != ~(uint64_t)0)) {
	    return 1;
	}
    }
    w = b->words[lw];   // the last word: ignore the unused bits (see above)
    return val ? (w != 0) : ((w | ~lm) != ~(uint64_t)0);                                            /* H05 deleted:clause | MISSED by all 35 tests | HasBit: last word, looking for 1, not masked | line 1217 || ALSO H06 deleted:clause | CAUGHT by 6: in-1.2 in-1.3 in-1.4 diff-1.1 diff-4.2 op-9.7 | HasBit: last word, looking for 0, padding not filled with ones => (w != ~(uint64_t)0) */
}

static int
BAInOper(Tcl_Interp *interp, Tcl_Obj *valueObj, Tcl_Obj *listObj, int *resPtr)
{
    BitArr *b = GETREP(listObj);
    const char *s = Tcl_GetString(valueObj);

    (void)interp;
    *resPtr = 0;
    if (b->width == 1) {
	if (s[0] && !s[1] && (s[0] == '0' || s[0] == '1')) {   // only the text "0" or "1" can be an element
	    *resPtr = HasBit(b, s[0] == '0');                                                       /* H10 changed:token | CAUGHT by 8: in-1.1 in-1.2 in-1.3 in-1.4 diff-1.1 diff-4.2 op-7.9 op-9.7 | BAInOper: 1-bit value letter inverted | line 1230 */
	}
    } else {
	/*
	 * "in" compares string forms, so only the canonical decimal spelling
	 * of an element matches ("007" does not match 7).
	 */
	uint64_t val;
	char buf[32];

	if (ParseValue(NULL, valueObj, b->width, b->isSigned, &val) == TCL_OK) {
	    snprintf(buf, sizeof(buf), "%lld", (long long)val);   // the canonical text of the value
