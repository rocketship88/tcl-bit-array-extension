static int
ParseBit(Tcl_Interp *interp, Tcl_Obj *obj, int *bitPtr)
{
    Tcl_WideInt v;

    /* Fast path: a literal 0 or 1 that already has a string representation. */
    if (obj->bytes != NULL && obj->length >= 1                                                      /* M25 changed:operator | CAUGHT by 1: set-1.11 | ParseBit fast path accepts longer | line 568-569 */
	    && (obj->bytes[0] == '0' || obj->bytes[0] == '1')) {
	*bitPtr = obj->bytes[0] - '0';
	return TCL_OK;
    }
    if (Tcl_GetWideIntFromObj(NULL, obj, &v) != TCL_OK || (v != 0 && v != 1)) {   // NULL: no error message from here
	if (interp) {
	    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		    "expected 0 or 1 but got \"%s\"", Tcl_GetString(obj)));
	    Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	}
	return TCL_ERROR;
    }
    *bitPtr = (int)v;
    return TCL_OK;
}

/*
 * Parse an element value for an array of WIDTH bits into its raw bit pattern.
 * Widths 8, 16 and 32 are unsigned, or signed if ISSIGNED (-8, -16, -32: the
 * value is stored as its low WIDTH bits); width 64 is always signed.
