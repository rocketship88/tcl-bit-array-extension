	    && obj->bytes[0] >= '0' && obj->bytes[0] <= 'z') {                                      /* W13 changed:token | CAUGHT by 1: range-8.4 | ParseValue digit fast path too wide | line 606 */
	*vp = (uint64_t)(obj->bytes[0] - '0');
