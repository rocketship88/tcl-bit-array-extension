	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		"bitarray %s: arrays differ in length (%" TCL_SIZE_MODIFIER
		"d vs %" TCL_SIZE_MODIFIER "d); use -length zero to allow it",
		name, x->len, y->len));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    return TCL_OK;
