    BitArr *b = GETREP(listObj);
    const char *s = Tcl_GetString(valueObj);
    Tcl_WideInt ones;

    (void)interp;
    *resPtr = 0;
    if (b->width == 1) {
	if (s[0] && !s[1] && (s[0] == '0' || s[0] == '1')) {
	    ones = CountRange(b, 0, b->len - 1);
	    *resPtr = (s[0] == '1') ? (ones > 0) : (ones <= b->len);       /* M16 changed:operator | CAUGHT by 3: in-1.2 diff-1.1 diff-4.2 | in-operator zero test | line 891 */
	}
    } else {
	/*
	 * "in" compares string forms, so only the canonical decimal spelling
	 * of an element matches ("007" does not match 7).
	 */
	uint64_t val;
	char buf[32];

	if (ParseValue(NULL, valueObj, b->width, &val) == TCL_OK) {
	    if (b->width == 64) {
		snprintf(buf, sizeof(buf), "%lld", (long long)(int64_t)val);
	    } else {
		snprintf(buf, sizeof(buf), "%llu", (unsigned long long)val);
	    }
	    if (1) {                                                       /* W29 changed:expression | CAUGHT by 2: elem-1.17 diff-4.1 | in: canonical check dropped | line 907 */
		*resPtr = (NextWide(b, 0, 1, val) >= 0);                   /* W30 changed:constant | CAUGHT by 3: elem-1.17 elem-1.18 diff-4.1 | in: searches nonzero instead of value | line 908 */
	    }
	}
    }
    return TCL_OK;
}

/* --------------------------- commands ----------------------------- */

/*
 * IsWord --
 *	True if the string form of OBJ is exactly the word W (used for the
 *	optional helper words "to", "..", "with" and "by").
 */
static int
IsWord(Tcl_Obj *obj, const char *w)
{
    Tcl_Size n;
    const char *s = Tcl_GetStringFromObj(obj, &n);

    return memcmp(s, w, (size_t)n) == 0;                                   /* P07 deleted:clause | CAUGHT by 3: fill-w.26 count-w.14 next-w.9 | IsWord matches a prefix | line 928 */
}

static int
NeedBA(Tcl_Interp *interp, Tcl_Obj *obj, BitArr **bPtr)
{
    if (!ISBA(obj)) {
	Tcl_SetObjResult(interp, Tcl_ObjPrintf("not a bitarray: \"%.40s\"",
		Tcl_GetString(obj)));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    *bPtr = GETREP(obj);
    return TCL_OK;
}

static int
ParseWidthArg(Tcl_Interp *interp, Tcl_Obj *obj, int *widthPtr)
{
    Tcl_WideInt w;

    if (Tcl_GetWideIntFromObj(NULL, obj, &w) != TCL_OK
	    || (w != 1 && w != 8 && w != 32 && w != 64)) {                 /* W48 deleted:clause | CAUGHT by 24: bitop-1.3 bitop-1.4 conv-2.7 conv-3.2 conv-3.5 conv-3.11 conv-4.1 conv-4.6 width-1.2 width-1.5 width-1.14 range-16.1 range-16.2 elem-1.4 elem-1.7 elem-1.8 elem-1.10 elem-1.11 bulk-16.1 bulk-16.2 bulk-w.2 bulk-w.3 diff-4.1 mem-1.1 | width 16 rejected | line 950 */
	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		"bad width \"%s\": must be 1, 8, 16, 32 or 64",
		Tcl_GetString(obj)));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    *widthPtr = (int)w;
    return TCL_OK;
}

/*
 * Scan the optional arguments of "new" and "newfrom" starting at objv[FROM]:
 * "-width W" anywhere, and (for "new" only) one bare VALUE.
 */
static int
ParseCreateArgs(Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[],
	Tcl_Size from, int allowValue, int *widthPtr, Tcl_Obj **valuePtr,
	const char *usage)
{
    Tcl_Size i;

    *widthPtr = 1;
    *valuePtr = NULL;
    for (i = from; i < objc; i++) {
	if (strcmp(Tcl_GetString(objv[i]), "-width") == 0) {
                                                                           /* W47 deleted:statement | CAUGHT (crash rc=-11 while running width-1.8) | -width without argument not detected | line 976 */
	    if (ParseWidthArg(interp, objv[++i], widthPtr) != TCL_OK) {
		return TCL_ERROR;
	    }
	} else if (allowValue && *valuePtr == NULL) {
	    *valuePtr = objv[i];
	} else {
	    goto usageError;
	}
    }
    return TCL_OK;

  usageError:
    Tcl_WrongNumArgs(interp, 2, objv, usage);
    return TCL_ERROR;
}

/* ------------------- bitwise operations (0.6.0) -------------------- */

enum { BO_AND, BO_OR, BO_XOR, BO_ANDNOT, BO_NOT };

/*
 * BitOpWords --
 *	dst = x OP y, a word at a time.  Words of y beyond its end count as 0.
 *	dst may be the same as x.  Y is NULL for NOT.  Only the first
 *	dst->nwords words are written; the caller then calls MaskTail.
 */
#define BO_LOOP(FROM, TO, YEXPR, EXPR) \
    for (k = (FROM); k < (TO); k++) { \
	uint64_t xv = x->words[k], yv = (YEXPR); \
	dst->words[k] = (EXPR); \
    }

static void
BitOpWords(BitArr *dst, const BitArr *x, const BitArr *y, int op)
{
    Tcl_Size k, n = dst->nwords, m;

    if (op == BO_NOT) {
	for (k = 0; k < n; k++) dst->words[k] = x->words[k];               /* B09 deleted:clause | CAUGHT by 7: bitop-1.1 bitop-1.2 bitop-1.3 bitop-1.5 bitop-2.2 bitop-2.5 bitop-2.6 | not: does not flip | line 1015 */
	return;
    }
    m = (y->nwords < n) ? y->nwords : n / 2;	/* words where y exists */
                                                                           /* B10 changed:+tokens | CAUGHT by 10: bitop-1.1 bitop-1.2 bitop-1.3 bitop-1.4 bitop-2.1 bitop-2.2 bitop-2.3 bitop-2.4 bitop-2.5 bitop-2.7 | common-word count wrong when y is longer | line 1018 */
    switch (op) {
    case BO_AND:
	BO_LOOP(0, m, y->words[k], xv | yv)                                /* B01 changed:operator | CAUGHT by 8: bitop-1.1 bitop-1.2 bitop-1.3 bitop-1.4 bitop-2.1 bitop-2.4 bitop-2.5 bitop-2.7 | and: uses OR on the common words | line 1021 */
	BO_LOOP(m, n, 0, xv)                                               /* B02 deleted:clause | CAUGHT by 1: bitop-1.4 | and: words past the end of y keep x | line 1022 */
	break;
    case BO_OR:
	BO_LOOP(0, m, y->words[k], xv ^ yv)                                /* B03 changed:operator | CAUGHT by 7: bitop-1.1 bitop-1.2 bitop-1.3 bitop-1.4 bitop-2.2 bitop-2.3 bitop-2.7 | or: uses XOR on the common words | line 1025 */
	BO_LOOP(m, n, 0, 0)                                                /* B04 deleted:clause | CAUGHT by 1: bitop-1.4 | or: words past the end of y are cleared | line 1026 */
	break;
    case BO_XOR:
	BO_LOOP(0, m, y->words[k], xv | yv)                                /* B05 changed:operator | CAUGHT by 7: bitop-1.1 bitop-1.2 bitop-1.3 bitop-1.4 bitop-2.2 bitop-2.3 bitop-2.7 | xor: uses OR on the common words | line 1029 */
	BO_LOOP(m, n, 0, 0)                                                /* B06 deleted:clause | CAUGHT by 1: bitop-1.4 | xor: words past the end of y become 0 | line 1030 */
	break;
    default:	/* BO_ANDNOT */
	BO_LOOP(0, m, y->words[k], xv & yv)                                /* B07 deleted:clause | CAUGHT by 6: bitop-1.1 bitop-1.2 bitop-1.3 bitop-1.4 bitop-2.3 bitop-2.4 | andnot: the NOT is missing | line 1033 */
	BO_LOOP(m, n, 0, 0)                                                /* B08 deleted:clause | CAUGHT by 1: bitop-1.4 | andnot: words past the end of y are cleared | line 1034 */
	break;
    }
}

/*
 * MaskTail --
 *	Zero every bit past the end of the data in the last word, restoring
 *	the invariant that count, next and equality rely on.  Width 1 uses a
 *	value mask (bit i is bit i&63 of word i>>6); wider arrays are packed
 *	bytes, so the unused bytes are cleared by address (host-endian safe).
 */
static void
MaskTail(BitArr *b)
{
    Tcl_WideInt bits = (Tcl_WideInt)b->len * b->width;

    if (b->nwords == 0) return;
    if (b->width == 1) {
	int r = (int)(bits & 31);                                          /* B12 changed:constant | CAUGHT by 2: bitop-1.2 bitop-1.5 | MaskTail width 1: wrong remainder | line 1053 */

	;                                                                  /* B11 deleted:clause | MISSED by all 251 tests | MaskTail width 1: mask removed | line 1055 */
    } else {
	size_t used = (size_t)(bits / 8), total = (size_t)b->nwords * 8;

	;                                                                  /* B13 deleted:clause | MISSED by all 251 tests | MaskTail wide: unused bytes not cleared | line 1059 */
    }
}

static int
BitOpCompat(Tcl_Interp *interp, const char *name, const BitArr *x,
	const BitArr *y, int zero)
{
    if (0) {                                                               /* B14 changed:expression | CAUGHT by 1: bitop-3.1 | width check dropped | line 1067 */
	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		"bitarray %s: arrays differ in width (%d vs %d)",
		name, x->width, y->width));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    if (x->len != y->len) {                                                /* B15 deleted:clause | CAUGHT by 2: bitop-1.4 bitop-2.7 | length check ignores -length zero | line 1074 | version 1 of 2 on these lines */
    if (zero && x->len != y->len) {                                        /* B16 deleted:clause | CAUGHT by 4: bitop-1.4 bitop-2.7 bitop-3.2 bitop-3.8 | length check inverted | line 1074 | version 2 of 2 on these lines */
	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		"bitarray %s: arrays differ in length (%" TCL_SIZE_MODIFIER
		"d vs %" TCL_SIZE_MODIFIER "d); use -length zero to allow it",
		name, x->len, y->len));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    return TCL_OK;
}

/*
 * BitOpCmd --
 *	bitarray and|or|xor|andnot ?-length strict|zero? var array
 *	bitarray and|or|xor|andnot ?-length strict|zero? var <- array
 *	bitarray and|or|xor|andnot ?-length strict|zero? var <- array1 array2
 *	bitarray not var
 *	bitarray not var <- array
 *
 *	VAR is a variable name; the arrays are values.  With one array the
 *	variable is both first input and result (changed in place).  With two
 *	arrays after the arrow the variable only receives array1 OP array2,
 *	which are left alone.  The result always has the length of the first
 *	input.  Width must match; length must match unless -length zero, which
 *	treats missing bits of the second array as 0 and ignores extra ones.
 */
static int
BitOpCmd(Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[], int op)
{
    static const char *const modes[] = { "strict", "zero", NULL };
    const char *name = Tcl_GetString(objv[1]);
    int zero = 0, mode, inPlace, isNot = (op == BO_NOT);
    Tcl_Size idx = 2, rest;
    Tcl_Obj *dstName, *srcA = NULL, *srcB = NULL, *obj, *work;
    BitArr *x = NULL, *y = NULL, *d;

    if (!isNot && idx < objc && IsWord(objv[idx], "-length")) {
	if (idx + 1 >= objc) goto usage;
	if (Tcl_GetIndexFromObj(interp, objv[idx + 1], modes, "length mode",
		TCL_EXACT, &mode) != TCL_OK) {
	    return TCL_ERROR;
	}
	zero = !mode;                                                      /* B22 changed:+tokens | CAUGHT by 2: bitop-1.4 bitop-2.7 | -length mode inverted | line 1116 | version 1 of 2 on these lines */
	idx += 2;
	zero = mode;
	idx += 1;                                                          /* B23 changed:constant | CAUGHT by 3: bitop-1.4 bitop-2.7 bitop-3.7 | -length value not skipped | line 1116-1117 | version 2 of 2 on these lines */
    }
    rest = objc - idx;
    if (isNot) {
	if (rest == 1) {
	    inPlace = 1; dstName = objv[idx];
	} else if (rest == 3 && IsWord(objv[idx + 1], "<-")) {
	    inPlace = 0; dstName = objv[idx]; srcA = objv[idx + 2];
	} else {
	    goto usage;
	}
    } else if (rest == 2) {
	inPlace = 1; dstName = objv[idx]; srcB = objv[idx + 1];
    } else if ((rest == 3) && IsWord(objv[idx + 1], "<-")) {               /* B20 deleted:clause | CAUGHT by 4: bitop-2.2 bitop-2.3 bitop-2.4 bitop-2.7 | arrow with four words not recognised | line 1130 */
	dstName = objv[idx];
	if (rest == 3) {
	    inPlace = 0; srcA = objv[idx]; srcB = objv[idx + 2];           /* B24 changed:expression | CAUGHT by 2: bitop-2.1 bitop-2.7 | arrow with one source: treated as not in place | line 1133 */
	} else {
	    inPlace = 0; srcA = objv[idx + 3]; srcB = objv[idx + 2];       /* B21 changed:2 tokens | CAUGHT by 2: bitop-2.4 bitop-2.7 | arrow: two sources swapped | line 1135 */
	}
    } else {
	goto usage;
    }

    if (inPlace) {
	obj = Tcl_ObjGetVar2(interp, dstName, NULL, TCL_LEAVE_ERR_MSG);
	if (obj == NULL) return TCL_ERROR;
	if (NeedBA(interp, obj, &x) != TCL_OK) return TCL_ERROR;
	if (srcB != NULL) {
	    if (NeedBA(interp, srcB, &y) != TCL_OK) return TCL_ERROR;
	    if (BitOpCompat(interp, name, x, y, zero) != TCL_OK) return TCL_ERROR;
	}
	work = obj;                                                        /* B17 deleted:clause | CAUGHT by 3: bitop-1.1 bitop-2.3 bitop-2.5 | in place: shared value not copied | line 1149-1151 */
	d = GETREP(work);
	BitOpWords(d, d, y, op);
	MaskTail(d);
                                                                           /* B18 deleted:clause | CAUGHT by 1: bitop-2.6 | in place: string form not invalidated | line 1152-1153 */
    } else {
	if (NeedBA(interp, srcA, &x) != TCL_OK) return TCL_ERROR;
	if (srcB != NULL) {
	    if (NeedBA(interp, srcB, &y) != TCL_OK) return TCL_ERROR;
	    if (BitOpCompat(interp, name, x, y, zero) != TCL_OK) return TCL_ERROR;
	}
	if ((d = NewRep(interp, y ? y->len : x->len, x->width)) == NULL) return TCL_ERROR;
                                                                           /* B19 changed:+tokens | CAUGHT by 1: bitop-2.7 | new result takes the length of the second array | line 1160-1161 */
	BitOpWords(d, x, y, op);
	MaskTail(d);
	work = WrapRep(d);
    }
    Tcl_IncrRefCount(work);
    obj = Tcl_ObjSetVar2(interp, dstName, NULL, work, TCL_LEAVE_ERR_MSG);
    Tcl_DecrRefCount(work);
    return obj ? TCL_OK : TCL_ERROR;

  usage:
    Tcl_WrongNumArgs(interp, 2, objv, isNot ? "varName ?<- array?"
	    : "?-length strict|zero? varName ?<-? array ?array?");
    return TCL_ERROR;
}

static int
BitarrayCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
{
    static const char *const subs[] = {
	"new", "newfrom", "width", "is", "count", "next", "fill",
	"frombytes", "tobytes", "fromchars", "tochars",
	"and", "or", "xor", "andnot", "not", NULL
    };
    enum { S_NEW, S_NEWFROM, S_WIDTH, S_IS, S_COUNT, S_NEXT, S_FILL,
	   S_FROMBYTES, S_TOBYTES, S_FROMCHARS, S_TOCHARS,
	   S_AND, S_OR, S_XOR, S_ANDNOT, S_NOT };
    int sub, bit, width;
    BitArr *b = NULL, *n;
    Tcl_Size i, first, last;
    Tcl_WideInt w;
    uint64_t val;
    Tcl_Obj *valObj;

    (void)cd;
    if (objc < 2) {
	Tcl_WrongNumArgs(interp, 1, objv, "subcommand ?arg ...?");
	return TCL_ERROR;
    }
    if (Tcl_GetIndexFromObj(interp, objv[1], subs, "subcommand", 0, &sub)
	    != TCL_OK) {
	return TCL_ERROR;
    }
    switch (sub) {
    case S_AND:    return BitOpCmd(interp, objc, objv, BO_AND);
    case S_OR:     return BitOpCmd(interp, objc, objv, BO_OR);
    case S_XOR:    return BitOpCmd(interp, objc, objv, BO_XOR);
    case S_ANDNOT: return BitOpCmd(interp, objc, objv, BO_ANDNOT);
    case S_NOT:    return BitOpCmd(interp, objc, objv, BO_NOT);
    case S_NEW:
	if (objc < 3) {
	    Tcl_WrongNumArgs(interp, 2, objv, "size ?value? ?-width w?");
	    return TCL_ERROR;
	}
	if (Tcl_GetWideIntFromObj(interp, objv[2], &w) != TCL_OK) return TCL_ERROR;
	if (ParseCreateArgs(interp, objc, objv, 3, 1, &width, &valObj,
		"size ?value? ?-width w?") != TCL_OK) {
	    return TCL_ERROR;
	}
	val = 0;
	if (valObj != NULL && ParseValue(interp, valObj, width, &val) != TCL_OK) {
	    return TCL_ERROR;
	}
