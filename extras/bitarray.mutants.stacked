	BitOpWords(d, x, y, op);
	MaskTail(d);
	work = WrapRep(d);
    }
    Tcl_IncrRefCount(work);                                                 // keep the result alive until the variable has it
    obj = Tcl_ObjSetVar2(interp, dstName, NULL, work, TCL_LEAVE_ERR_MSG);   // the variable now holds the result
