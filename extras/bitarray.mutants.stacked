	    } else if (width == 8) {
		memset(n->words, (int)val, (size_t)n->len - 1);            /* W42 changed:+tokens | CAUGHT by 5: fill-w.10 width-1.3 width-1.4 elem-1.6 bulk-w.1 | new 8-bit init one short | line 1234 */
	    } else {
		for (i = 0; i < n->len - 1; i++) PutElem(n, i, val);       /* W43 changed:+tokens | CAUGHT by 5: fill-w.11 elem-1.7 elem-1.9 bulk-16.1 bulk-w.2 | new generic init one short | line 1236 */
