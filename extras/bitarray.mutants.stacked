	}
    } else {
	for (i = 0; i < len; i++) {
	    if (GETBIT(b, from + i)) SETBIT(n, i);
	}
    }
    *newObjPtr = WrapRep(n);
    return TCL_OK;
}

static int
BAReverse(Tcl_Interp *interp, Tcl_Obj *objPtr, Tcl_Obj **newObjPtr)
{
    BitArr *b = GETREP(objPtr), *n;
    Tcl_Size i;

    if ((n = NewRep(interp, b->len, b->width)) == NULL) return TCL_ERROR;
    if (b->width == 1) {
	for (i = 0; i < b->len; i++) {
	    if (GETBIT(b, b->len - i)) SETBIT(n, i);                      /* M09 deleted:clause | CAUGHT by 4: rev-1.1 rev-1.2 diff-1.1 diff-4.2 | reverse off by one | line 605 */
	}
    } else {
	for (i = 0; i < b->len; i++) {
	    PutElem(n, i, GetElem(b, b->len - i));                        /* W23 deleted:clause | CAUGHT by 2: elem-1.11 diff-4.1 | Reverse wide off by one | line 609 */
	}
    }
    *newObjPtr = WrapRep(n);
    return TCL_OK;
