		memset(p, c, (size_t)(last - first + 1));                                           /* W38 deleted:clause | CAUGHT by 5: fill-w.10 conv-2.5 bulk-8.2 diff-4.1 signed-1.15 | fill 8-bit memset wrong start | line 2019 | version 2 of 2 on these lines */
	    } else {
		for (i = first; ; i += (Tcl_Size)step) {
