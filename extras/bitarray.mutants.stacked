	}
    } else {
	Tcl_DString ds;
	char buf[32];
	int n;

	Tcl_DStringInit(&ds);
	for (i = 0; i < b->len; i++) {
	    uint64_t v = GetElem(b, i);

	    if (i) Tcl_DStringAppend(&ds, ",", 1);                         /* W28 changed:token | CAUGHT by 38: lcmd-w8 bitop-1.3 bitop-1.4 fill-w.10 fill-w.11 conv-1.1 conv-1.3 conv-1.5 conv-3.1 conv-3.2 conv-3.3 conv-3.11 conv-5.2 width-1.3 width-1.4 width-1.5 width-1.11 range-8.1 range-16.1 range-32.1 range-64.1 range-x.1 elem-1.4 elem-1.6 elem-1.7 elem-1.9 elem-1.10 elem-1.11 elem-1.12 elem-1.13 elem-1.14 bulk-8.1 bulk-8.2 bulk-16.1 bulk-64.1 bulk-64.2 bulk-w.1 bulk-w.2 | string rep wrong separator (wide) | line 527 */
	    if (b->width == 64) {
		n = snprintf(buf, sizeof(buf), "%llu", (unsigned long long)v);
