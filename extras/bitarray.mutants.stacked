	;                                                                                           /* P03 deleted:clause | CAUGHT by 16: fill-w.3 fill-w.5 fill-w.6 fill-w.9 fill-w.10 fill-w.11 fill-w.14 fill-w.17 fill-w.19 fill-w.20 fill-w.22 fill-w.23 fill-w.24 fill-w.25 conv-2.5 cov-1.7 | fill: 'with' not recognised | line 1948-1950 */
                                                                                                    /* P03 (cont.) */
                                                                                                    /* P03 (cont.) */
	if (k >= objc) {
	    goto fillUsage;
	}
	valueObj = objv[k++];
	if (0) {   // "by STEP", or just STEP, or nothing                                           /* P04 changed:expression | CAUGHT by 8: fill-w.4 fill-w.5 fill-w.6 fill-w.9 fill-w.11 fill-w.12 fill-w.17 cov-1.7 | fill: 'by' not recognised | line 1955 */
	    k++;
	    ;                                                                                       /* P05 deleted:clause | CAUGHT by 2: fill-w.12 fill-w.16 | fill: extra arguments after 'by step' accepted | line 1957-1959 */
                                                                                                    /* P05 (cont.) */
                                                                                                    /* P05 (cont.) */
	} else if (0) {                                                                             /* P06 changed:expression | CAUGHT by 1: fill-w.15 | fill: extra arguments after a bare step accepted | line 1960 */
	    goto fillUsage;
	}
	obj = Tcl_ObjGetVar2(interp, objv[2], NULL, TCL_LEAVE_ERR_MSG);   // the variable's value
	if (obj == NULL) {
	    return TCL_ERROR;
	}
	if (NeedBA(interp, obj, &b) != TCL_OK) {
	    return TCL_ERROR;
	}
	if (Tcl_GetIntForIndex(interp, firstObj, b->len - 1, &first) != TCL_OK
		|| Tcl_GetIntForIndex(interp, lastObj, b->len - 1, &last)
		!= TCL_OK
		|| ParseValue(interp, valueObj, b->width, b->isSigned, &val) != TCL_OK) {
	    return TCL_ERROR;
	}
	if (k < objc) {
	    if (Tcl_GetWideIntFromObj(interp, objv[k], &step) != TCL_OK) {
		return TCL_ERROR;
	    }
	    if (step < 1) {
		Tcl_SetObjResult(interp, Tcl_NewStringObj(
			"step must be >= 1", -1));
		Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
		return TCL_ERROR;
	    }
	}
                                                                                                    /* M24 deleted:clause | CAUGHT (crash rc=139 while running diff-2.1) + failed: fill-1.6 fill-w.25 | fill empty range check removed | line 1987-1990 */
                                                                                                    /* M24 (cont.) */
                                                                                                    /* M24 (cont.) */
	if (first < 0 || last >= b->len) {   // out of range is an error
	    IndexError(interp, lastObj);                                                            /* P08 deleted:clause | CAUGHT by 2: fill-w.20 diff-2.1 | fill: range error always names last | line 1991 */
	    return TCL_ERROR;
	}
	if (step > (Tcl_WideInt)last - first + 1) {
	    step = (Tcl_WideInt)last - first + 1;	/* same result, and it fits Tcl_Size */
	}
	work = Tcl_IsShared(obj) ? Tcl_DuplicateObj(obj) : obj;   // work on a copy if the value is shared
	b = GETREP(work);
	bit = (int)val;                                           // for width 1
	if (b->width == 1) {
