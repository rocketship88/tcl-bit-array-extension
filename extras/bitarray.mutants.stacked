    Tcl_Size i, len;

                                                                          /* M08 deleted:clause | MISSED by all 184 tests | slice lower clamp removed | line 570-571 | version 1 of 2 on these lines */
    if (to >= b->len) to = b->len - 1;
    if (from < 0) from = 0;
    if (to > b->len) to = b->len - 1;                                     /* M06 changed:operator | MISSED by all 184 tests | slice upper clamp | line 571 | version 2 of 2 on these lines */
    if (from > to || from >= b->len) {
	*newObjPtr = Tcl_NewObj();
	return TCL_OK;
    }
    len = to - from + 1;
    if ((n = NewRep(interp, len, b->width)) == NULL) return TCL_ERROR;
    if (b->width != 1) {
	memcpy(BYTES(n), BYTES(b) + (size_t)from,                         /* W21 deleted:clause | CAUGHT by 2: elem-1.10 diff-4.1 | Slice wide copies from offset 0 units | line 579 */
		(size_t)len);                                             /* W22 deleted:clause | CAUGHT by 2: elem-1.10 diff-4.1 | Slice wide copies too few bytes | line 580-581 */
    } else if ((from & 63) == 0) {
