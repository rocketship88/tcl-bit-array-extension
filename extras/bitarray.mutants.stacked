static int
BAGetElements(Tcl_Interp *interp, Tcl_Obj *objPtr, Tcl_Size *objcPtr,
	Tcl_Obj ***objvPtr)
{
    BitArr *b = GETREP(objPtr);
    Tcl_Size i;

    if (b->elems == NULL) {
	if ((size_t)b->len > (size_t)-1 / sizeof(Tcl_Obj *) / 2) {
	    if (interp) {
		Tcl_SetObjResult(interp, Tcl_NewStringObj("out of memory", -1));
	    }
	    return TCL_ERROR;
	}
	b->elems = (Tcl_Obj **)Tcl_AttemptAlloc(
		(size_t)(b->len ? b->len : 1) * sizeof(Tcl_Obj *));
	if (b->elems == NULL) {
	    if (interp) {
		Tcl_SetObjResult(interp, Tcl_NewStringObj("out of memory", -1));
	    }
	    return TCL_ERROR;
	}
	if (b->width == 1) {
	    for (i = 0; i < b->len; i++) {
		b->elems[i] = GETBIT(b, i) ? b->zero : b->one;            /* M30 changed:2 tokens | CAUGHT by 5: iter-1.1 diff-1.1 diff-3.1 diff-2.1 diff-4.2 | elems cache swapped | line 640 */
	    }
	} else {
	    for (i = 0; i < b->len; i++) {
		Tcl_Obj *e = ElemObj(b, GetElem(b, i));

		                                                          /* W19 deleted:statement | CAUGHT (crash rc=-11 while running diff-4.1) | GetElements forgets to take a reference | line 646 */
		b->elems[i] = e;
	    }
	}
                                                                          /* W20 deleted:statement | CAUGHT by 1: mem-1.1 | GetElements does not record its length | line 650 */
    }
    *objcPtr = b->len;
    *objvPtr = b->elems;
    return TCL_OK;
}

static Tcl_Obj *
BASetElement(Tcl_Interp *interp, Tcl_Obj *listPtr, Tcl_Size indexCount,
	Tcl_Obj *const indexArray[], Tcl_Obj *valueObj)
{
    BitArr *b;
    Tcl_Size idx;
    uint64_t val;
    Tcl_Obj *obj = listPtr;

    if (indexCount != 1) {
	if (interp) {
	    Tcl_SetObjResult(interp, Tcl_NewStringObj(
		    "bitarray elements are not lists", -1));
	    Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	}
	return NULL;
    }
    b = GETREP(listPtr);
    if (Tcl_GetIntForIndex(interp, indexArray[0], b->len - 1, &idx) != TCL_OK) {
	return NULL;
    }
    if (idx == TCL_SIZE_MAX && b->len == 0) {
	idx = 0;		/* Same special case as the core's TclLsetFlat. */
    }
    if (idx < 0 || idx >= b->len) {                                       /* M10 changed:operator | CAUGHT by 9: set-1.4 set-1.9 set-1.10 diff-1.1 grow-1.5 diff-3.1 elem-1.7 diff-4.1 diff-4.2 | setElement append disabled | line 681-682 */
	IndexError(interp, indexArray[0]);
	return NULL;
    }
    if (ParseValue(interp, valueObj, 1, &val) != TCL_OK) return NULL;     /* W50 changed:expression | CAUGHT by 9: width-1.14 elem-1.4 elem-1.5 elem-1.7 elem-1.9 elem-1.19 bulk-8.5 diff-4.1 mem-1.1 | setElement parses as 1-bit | line 685 */
    if (0) {                                                              /* M11 changed:expression | CAUGHT by 5: set-1.1 set-1.2 set-1.3 diff-1.1 elem-1.9 | setElement never duplicates | line 686-689 */
	obj = Tcl_DuplicateObj(obj);
    }
    if (idx == GETREP(obj)->len) {
	/* lset on a list with index == length appends. */
	if (BAReplace(interp, obj, idx, 0, 1, &valueObj) != TCL_OK) {
	    if (obj != listPtr) Tcl_BounceRefCount(obj);
	    return NULL;
	}
	return obj;
    }
    b = GETREP(obj);
    PutElem(b, idx, val);
    Touch(obj);
    return obj;
}

/*
 * Copy COUNT elements from FROM to TO within one array, as memmove would.
 */
static void
MoveElems(BitArr *b, Tcl_Size from, Tcl_Size to, Tcl_Size count)
{
    Tcl_Size i;

    if (from == to || count <= 0) return;
    if (b->width != 1) {
	memcpy(BYTES(b) + (size_t)to * EBYTES(b),                         /* W24 changed:name/variable | MISSED by all 184 tests | MoveElems wide memmove -> memcpy | line 713 | version 1 of 2 on these lines */
	memmove(BYTES(b) + (size_t)to,                                    /* W25 deleted:clause | CAUGHT by 1: diff-4.1 | MoveElems wide wrong destination unit | line 713 | version 2 of 2 on these lines */
		BYTES(b) + (size_t)from * EBYTES(b), (size_t)count * EBYTES(b));
	return;
    }
    if (to > from) {                                                      /* M37 changed:operator | CAUGHT by 4: diff-1.1 grow-1.3 diff-3.1 diff-4.2 | MoveElems direction reversed | line 717-718 */
	for (i = 0; i < count; i++) {
	    if (GETBIT(b, from + i)) SETBIT(b, to + i); else CLRBIT(b, to + i);
	}
    } else {
	for (i = count - 1; i >= 0; i--) {
	    if (GETBIT(b, from + i)) SETBIT(b, to + i); else CLRBIT(b, to + i);
	}
    }
}

/*
 * lreplace / linsert / lappend.  Edits the array in place.  The array keeps
 * spare capacity and doubles it when full, so appending one element at a time
 * costs O(1) on average, as it does for a list.  The caller guarantees the
 * object is not shared.
 */
static int
BAReplace(Tcl_Interp *interp, Tcl_Obj *listObj, Tcl_Size first,
	Tcl_Size numToDelete, Tcl_Size numToInsert, Tcl_Obj *const insertObjs[])
{
    BitArr *b = GETREP(listObj);
    Tcl_Size i, newLen, oldLen = b->len, needWords;
    Tcl_WideInt wideLen;
    uint64_t val;

    if (first < 0) first = 0;
                                                                          /* M42 deleted:statement | MISSED by all 184 tests | first-index clamp removed | line 744 */
    if (numToDelete < 0) numToDelete = 0;
                                                                          /* M14 deleted:statement | CAUGHT by 1: repl-1.1 | replace delete clamp removed | line 746 */
    for (i = 0; i < numToInsert; i++) {
	if (ParseValue(interp, insertObjs[i], 1, &val) != TCL_OK) {       /* W51 changed:expression | CAUGHT by 6: width-1.14 elem-1.7 elem-1.12 elem-1.19 diff-4.1 mem-1.1 | replace validates as 1-bit | line 748 */
	    return TCL_ERROR;
	}
    }
    wideLen = (Tcl_WideInt)oldLen - numToDelete + numToInsert;
    if (0) {                                                              /* M34 changed:expression | MISSED by all 184 tests | replace: growth limit dropped | line 753 */
	if (interp) {
	    Tcl_SetObjResult(interp, Tcl_NewStringObj(
		    "bitarray size out of range", -1));
	    Tcl_SetErrorCode(interp, "TCL", "VALUE", "SIZE", NULL);
	}
	return TCL_ERROR;
    }
    newLen = (Tcl_Size)wideLen;
    needWords = (newLen + 63) / 64;                                       /* W52 changed:expression | CAUGHT (crash rc=-11 while running diff-4.1) + failed: elem-1.19 | replace sizes storage for 1-bit | line 762 */

    /* Grow the allocation (doubling) if the new length does not fit. */
    if (needWords > b->capWords) {
	Tcl_Size maxWords = (Tcl_Size)((BA_MAX_BITS + 63) / 64);
	Tcl_Size newCap = 0, oldCap = b->capWords;                        /* M35 changed:expression | MISSED by all 184 tests | capacity not doubled | line 767 */
	BitArr *nb;

	if (newCap < 4) newCap = 4;
	if (newCap < needWords) newCap = needWords;
	if (newCap > maxWords) newCap = maxWords;
	nb = (BitArr *)Tcl_AttemptRealloc(b,
		sizeof(BitArr) + (size_t)(newCap - 1) * sizeof(uint64_t));
	if (nb == NULL && newCap > needWords) {
	    newCap = needWords;
	    nb = (BitArr *)Tcl_AttemptRealloc(b,
		    sizeof(BitArr) + (size_t)(newCap - 1) * sizeof(uint64_t));
	}
	if (nb == NULL) {
	    if (interp) {
		Tcl_SetObjResult(interp, Tcl_NewStringObj("out of memory", -1));
		Tcl_SetErrorCode(interp, "TCL", "MEMORY", NULL);
	    }
	    return TCL_ERROR;
	}
	b = nb;
                                                                          /* M38 deleted:statement | MISSED by all 184 tests | new capacity not zeroed | line 788-789 */
                                                                          /* M38 (cont.) */
	b->capWords = newCap;
	;                                                                 /* M39 deleted:clause | CAUGHT (crash rc=-4 while running grow-1.4) | rep pointer not updated after realloc | line 791-792 */
    }

                                                                          /* M41 deleted:statement | CAUGHT (crash rc=-11 while running diff-1.1) | element cache not dropped by replace | line 794-795 */
                                                                          /* M41 (cont.) */

    /* Slide the tail, write the inserted values, clear what was vacated. */
    MoveElems(b, first + numToDelete, first + numToInsert,
	    oldLen - (first + numToDelete) - 1);                          /* M15 changed:+tokens | CAUGHT by 7: repl-1.1 diff-1.1 grow-1.3 diff-3.1 elem-1.12 diff-4.1 diff-4.2 | replace tail move count off by one | line 799 */
    for (i = 0; i < numToInsert; i++) {
	ParseValue(NULL, insertObjs[i], b->width, &val);
	PutElem(b, first + i, val);
    }
    if (newLen < oldLen) {
	if (b->width == 1) {
	    ;                                                             /* M36 deleted:clause | MISSED by all 184 tests | shrink does not clear vacated bits | line 806 */
	} else {
	    ;                                                             /* W26 deleted:clause | MISSED by all 184 tests | Replace wide vacated storage not cleared | line 808-809 */
                                                                          /* W26 (cont.) */
	}
    }
    b->len = newLen;
    b->nwords = needWords;
                                                                          /* M32 deleted:clause | CAUGHT by 1: diff-1.1 | replace leaves stale string | line 813-814 | version 1 of 2 on these lines */
                                                                          /* M40 deleted:clause | CAUGHT (crash rc=-4 while running diff-4.1) + failed: diff-1.1 diff-3.1 elem-1.19 | word count not updated | line 813-814 | version 2 of 2 on these lines */
    Tcl_InvalidateStringRep(listObj);
    return TCL_OK;
}

static int
BAInOper(Tcl_Interp *interp, Tcl_Obj *valueObj, Tcl_Obj *listObj, int *resPtr)
{
    BitArr *b = GETREP(listObj);
    const char *s = Tcl_GetString(valueObj);
    Tcl_WideInt ones;

    (void)interp;
    *resPtr = 0;
    if (b->width == 1) {
	if (s[0] && !s[1] && (s[0] == '0' || s[0] == '1')) {
	    ones = CountRange(b, 0, b->len - 1);
	    *resPtr = (s[0] == '1') ? (ones > 0) : (ones <= b->len);      /* M16 changed:operator | CAUGHT by 3: in-1.2 diff-1.1 diff-4.2 | in-operator zero test | line 830 */
	}
    } else {
	/*
	 * "in" compares string forms, so only the canonical decimal spelling
	 * of an element matches ("007" does not match 7).
	 */
	uint64_t val;
	char buf[32];

	if (ParseValue(NULL, valueObj, b->width, &val) == TCL_OK) {
	    if (b->width == 64) {
		snprintf(buf, sizeof(buf), "%lld", (long long)(int64_t)val);
	    } else {
		snprintf(buf, sizeof(buf), "%llu", (unsigned long long)val);
	    }
	    if (1) {                                                      /* W29 changed:expression | CAUGHT by 2: elem-1.17 diff-4.1 | in: canonical check dropped | line 846 */
		*resPtr = (NextWide(b, 0, 1, val) >= 0);                  /* W30 changed:constant | CAUGHT by 3: elem-1.17 elem-1.18 diff-4.1 | in: searches nonzero instead of value | line 847 */
	    }
	}
    }
    return TCL_OK;
}

/* --------------------------- commands ----------------------------- */

/*
 * IsWord --
 *	True if the string form of OBJ is exactly the word W (used for the
 *	optional helper words "to", "..", "with" and "by").
 */
static int
IsWord(Tcl_Obj *obj, const char *w)
{
    Tcl_Size n;
    const char *s = Tcl_GetStringFromObj(obj, &n);

    return memcmp(s, w, (size_t)n) == 0;                                  /* P07 deleted:clause | CAUGHT by 3: fill-w.26 count-w.14 next-w.9 | IsWord matches a prefix | line 867 */
}

static int
NeedBA(Tcl_Interp *interp, Tcl_Obj *obj, BitArr **bPtr)
{
    if (!ISBA(obj)) {
	Tcl_SetObjResult(interp, Tcl_ObjPrintf("not a bitarray: \"%.40s\"",
		Tcl_GetString(obj)));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    *bPtr = GETREP(obj);
    return TCL_OK;
}

static int
ParseWidthArg(Tcl_Interp *interp, Tcl_Obj *obj, int *widthPtr)
{
    Tcl_WideInt w;

    if (Tcl_GetWideIntFromObj(NULL, obj, &w) != TCL_OK
	    || (w != 1 && w != 8 && w != 32 && w != 64)) {                /* W48 deleted:clause | CAUGHT by 16: width-1.2 width-1.5 width-1.14 range-16.1 range-16.2 elem-1.4 elem-1.7 elem-1.8 elem-1.10 elem-1.11 bulk-16.1 bulk-16.2 bulk-w.2 bulk-w.3 diff-4.1 mem-1.1 | width 16 rejected | line 889 */
	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		"bad width \"%s\": must be 1, 8, 16, 32 or 64",
		Tcl_GetString(obj)));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    *widthPtr = (int)w;
    return TCL_OK;
}

/*
 * Scan the optional arguments of "new" and "newfrom" starting at objv[FROM]:
 * "-width W" anywhere, and (for "new" only) one bare VALUE.
 */
static int
ParseCreateArgs(Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[],
	Tcl_Size from, int allowValue, int *widthPtr, Tcl_Obj **valuePtr,
	const char *usage)
{
    Tcl_Size i;

    *widthPtr = 1;
    *valuePtr = NULL;
    for (i = from; i < objc; i++) {
	if (strcmp(Tcl_GetString(objv[i]), "-width") == 0) {
                                                                          /* W47 deleted:statement | CAUGHT (crash rc=-11 while running width-1.8) | -width without argument not detected | line 915 */
	    if (ParseWidthArg(interp, objv[++i], widthPtr) != TCL_OK) {
		return TCL_ERROR;
	    }
	} else if (allowValue && *valuePtr == NULL) {
	    *valuePtr = objv[i];
	} else {
	    goto usageError;
	}
    }
    return TCL_OK;

  usageError:
    Tcl_WrongNumArgs(interp, 2, objv, usage);
    return TCL_ERROR;
}

static int
BitarrayCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
{
    static const char *const subs[] = {
	"new", "newfrom", "width", "is", "count", "next", "fill", NULL
    };
    enum { S_NEW, S_NEWFROM, S_WIDTH, S_IS, S_COUNT, S_NEXT, S_FILL };
    int sub, bit, width;
    BitArr *b = NULL, *n;
    Tcl_Size i, first, last;
    Tcl_WideInt w;
    uint64_t val;
    Tcl_Obj *valObj;

    (void)cd;
    if (objc < 2) {
	Tcl_WrongNumArgs(interp, 1, objv, "subcommand ?arg ...?");
	return TCL_ERROR;
    }
    if (Tcl_GetIndexFromObj(interp, objv[1], subs, "subcommand", 0, &sub)
	    != TCL_OK) {
	return TCL_ERROR;
    }
    switch (sub) {
    case S_NEW:
	if (objc < 3) {
	    Tcl_WrongNumArgs(interp, 2, objv, "size ?value? ?-width w?");
	    return TCL_ERROR;
	}
	if (Tcl_GetWideIntFromObj(interp, objv[2], &w) != TCL_OK) return TCL_ERROR;
	if (ParseCreateArgs(interp, objc, objv, 3, 1, &width, &valObj,
		"size ?value? ?-width w?") != TCL_OK) {
	    return TCL_ERROR;
	}
	val = 0;
	if (valObj != NULL && ParseValue(interp, valObj, width, &val) != TCL_OK) {
