	        total += (p[i] == 0);                                                               /* W31 changed:operator | CAUGHT by 6: bitop-1.3 bitop-1.4 bulk-8.1 bulk-8.4 diff-4.1 signed-1.7 | CountWide 8-bit nonzero inverted | line 492 */
