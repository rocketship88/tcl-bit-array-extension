DLLEXPORT int
Bitarray_Init(Tcl_Interp *interp)
{
    if (Tcl_InitStubs(interp, "9.1", 0) == NULL) return TCL_ERROR;
    Tcl_CreateObjCommand2(interp, "bitarray", BitarrayCmd, NULL, NULL);
    return Tcl_PkgProvide(interp, "bitarray", "0.6.0");
}
