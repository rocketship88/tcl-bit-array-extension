	} else if (v >= 0 && v <= (Tcl_WideInt)(((uint64_t)1 << width))) {   // unsigned: 0 .. 2^width - 1
                                                                                                    /* W10 deleted:clause | CAUGHT by 6: range-8.2 range-16.2 range-32.2 elem-1.5 elem-1.13 bulk-8.3 | ParseValue upper bound off by one | line 622 | version 1 of 2 on these lines */
	} else if (v >= -1 && v <= (Tcl_WideInt)(((uint64_t)1 << width) - 1)) {   // unsigned: 0 .. 2^width - 1
                                                                                                    /* W11 changed:expression | CAUGHT by 3: range-8.3 elem-1.17 signed-1.4 | ParseValue accepts -1 | line 622 | version 2 of 2 on these lines */
	    *vp = (uint64_t)v;
	    return TCL_OK;
	}
    }
    if (interp) {   // reached for a non-number or a value out of range
	if (width == 64) {
	    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		    "expected integer in range -9223372036854775808..9223372036854775807"
		    " but got \"%s\"", Tcl_GetString(obj)));
	} else if (isSigned) {
	    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		    "expected integer in range %lld..%lld but got \"%s\"",
		    (long long)((uint64_t)1 << (width - 1)),                                        /* G22 deleted:clause | CAUGHT by 2: signed-1.3 signed-1.5 | signed range message: lower end positive | line 635 */
		    (long long)(((uint64_t)1 << (width - 1)) - 1),
		    Tcl_GetString(obj)));
