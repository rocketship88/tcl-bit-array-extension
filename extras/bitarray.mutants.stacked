static Tcl_Obj *
BASetElement(Tcl_Interp *interp, Tcl_Obj *listPtr, Tcl_Size indexCount,
	Tcl_Obj *const indexArray[], Tcl_Obj *valueObj)
{
    BitArr *b;
    Tcl_Size idx;
    uint64_t val;
    Tcl_Obj *obj = listPtr;

    if (indexCount != 1) {
	if (interp) {
	    Tcl_SetObjResult(interp, Tcl_NewStringObj(
		    "bitarray elements are not lists", -1));
	    Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	}
	return NULL;
    }
    b = GETREP(listPtr);
    if (Tcl_GetIntForIndex(interp, indexArray[0], b->len - 1, &idx) != TCL_OK) {
	return NULL;
    }
    if (idx == TCL_SIZE_MAX && b->len == 0) {
	idx = 0;		/* Same special case as the core's TclLsetFlat. */
    }
    if (idx < 0 || idx >= b->len) {                                        /* M10 changed:operator | CAUGHT by 9: set-1.4 set-1.9 set-1.10 diff-1.1 grow-1.5 diff-3.1 elem-1.7 diff-4.1 diff-4.2 | setElement append disabled | line 681-682 */
	IndexError(interp, indexArray[0]);
	return NULL;
    }
    if (ParseValue(interp, valueObj, 1, &val) != TCL_OK) return NULL;      /* W50 changed:expression | CAUGHT by 10: conv-2.4 width-1.14 elem-1.4 elem-1.5 elem-1.7 elem-1.9 elem-1.19 bulk-8.5 diff-4.1 mem-1.1 | setElement parses as 1-bit | line 685 */
    if (0) {                                                               /* M11 changed:expression | CAUGHT by 5: set-1.1 set-1.2 set-1.3 diff-1.1 elem-1.9 | setElement never duplicates | line 686-689 */
	obj = Tcl_DuplicateObj(obj);
    }
    if (idx == GETREP(obj)->len) {
	/* lset on a list with index == length appends. */
	if (BAReplace(interp, obj, idx, 0, 1, &valueObj) != TCL_OK) {
	    if (obj != listPtr) Tcl_BounceRefCount(obj);
	    return NULL;
	}
	return obj;
    }
    b = GETREP(obj);
    PutElem(b, idx, val);
    Touch(obj);
    return obj;
}

