/*
 * bitarray.c --
 *
 *	A packed array of small integers that looks like a Tcl list
 *	(llength, lindex, lset, lrange, lreverse, lreplace, foreach, "in",
 *	string representation), built on the Tcl 9 abstract-list hooks of
 *	Tcl_ObjType.  Extension only: no core changes.
 *
 *	Element width (chosen when the array is created, fixed afterwards):
 *	    1   bit      values 0 and 1
 *	    8   bits     unsigned, 0 .. 255
 *	    16  bits     unsigned, 0 .. 65535
 *	    32  bits     unsigned, 0 .. 4294967295
 *	    64  bits     signed,   -2^63 .. 2^63-1
 *
 *	Written by Claude (an AI model made by Anthropic) for Eric Taylor.
 *
 * Commands (all in the global command "bitarray"):
 *	bitarray new SIZE ?VALUE? ?-width W?     all elements VALUE (default 0)
 *	bitarray newfrom LIST ?-width W?         list of integers -> bitarray
 *	bitarray width BA                        1, 8, 16, 32 or 64
 *	bitarray is VALUE                        1 if VALUE has the bitarray rep
 *	bitarray count BA ?FIRST LAST ?VALUE??   elements equal to VALUE, or
 *	                                         non-zero if VALUE is omitted
 *	bitarray next BA START ?VALUE?           first index >= START holding
 *	                                         VALUE (default: non-zero), or -1
 *	bitarray fill VARNAME FIRST LAST VALUE ?STEP?
 *	                            set every STEP-th element in FIRST..LAST
 *	                            (in place, like lset; returns empty string)
 */

#include <tcl.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>

/*
 * 32-bit / 64-bit.  Tcl_Size has the width of a pointer, so on a 32-bit build
 * it is 32 bits.  BA_MAX_BITS is the largest array we allow, counted in TOTAL
 * BITS of storage (elements times element width); sizes are always checked as
 * 64-bit values BEFORE they are narrowed to Tcl_Size.
 *   64-bit: 2^40 bits (128 GiB).
 *   32-bit: 2^30 - 1 bits (128 MiB), so that 2*len-1 (the string
 *           representation) and len+63 cannot overflow a signed 32-bit size.
 */
#if SIZE_MAX > 0xFFFFFFFFu && !defined(BA_FORCE_32BIT_LIMITS)
#   define BA_MAX_BITS	((Tcl_WideInt)1 << 41)                            /* M04 changed:constant | CAUGHT by 3: new-1.5 range-x.2 range-x.3 | size limit 2^40 -> 2^41 | line 47 */
#else
#   define BA_MAX_BITS	((Tcl_WideInt)0x3FFFFFFF)
#endif

/*
 * Population count and count-trailing-zeros on a 64-bit word.  GCC and clang
 * have builtins; anywhere else (or with -DBA_NO_BUILTINS) use plain C.
 */
#if (defined(__GNUC__) || defined(__clang__)) && !defined(BA_NO_BUILTINS)
#   define BA_POPCOUNT(x)	__builtin_popcountll(x)
#   define BA_CTZ(x)		__builtin_ctzll(x)
#else
static int
BaPopcount(uint64_t x)
{
    x = x - ((x >> 1) & 0x5555555555555555ULL);
    x = (x & 0x3333333333333333ULL) + ((x >> 2) & 0x3333333333333333ULL);
    x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0FULL;
    return (int)((x * 0x0101010101010101ULL) >> 56);
}
static int
BaCtz(uint64_t x)		/* x must be non-zero */
{
    int n = 0;

    if (!(x & 0xFFFFFFFFULL)) { n += 32; x >>= 32; }
    if (!(x & 0xFFFFULL))     { n += 16; x >>= 16; }
    if (!(x & 0xFFULL))       { n += 8;  x >>= 8; }
    if (!(x & 0xFULL))        { n += 4;  x >>= 4; }
    if (!(x & 0x3ULL))        { n += 2;  x >>= 2; }
    if (!(x & 0x1ULL))        { n += 1; }
    return n;
}
#   define BA_POPCOUNT(x)	BaPopcount(x)
#   define BA_CTZ(x)		BaCtz(x)
#endif

typedef struct BitArr {
    Tcl_Size len;		/* Number of elements. */
    Tcl_Size nwords;		/* 64-bit words in use: (len*width + 63) / 64. */
    Tcl_Size capWords;		/* Words allocated (>= nwords); every bit at or
				 * beyond the end of the data, up to the
				 * capacity, is 0. */
    int width;			/* Bits per element: 1, 8, 16, 32 or 64. */
    Tcl_Obj *zero, *one;	/* Shared element values handed out by index. */
    Tcl_Obj **elems;		/* Lazily built element vector, or NULL. */
    Tcl_Size elemsLen;		/* Number of entries in elems. */
    uint64_t words[1];		/* Storage (at least one word is always
				 * present).  Width 1: bit i is bit (i&63) of
				 * word i>>6.  Wider: elements packed as bytes
				 * in host order, read and written only through
				 * GetElem/PutElem. */
} BitArr;

static Tcl_ObjTypeLengthProc	BALength;
static Tcl_ObjTypeIndexProc	BAIndex;
static Tcl_ObjTypeSliceProc	BASlice;
static Tcl_ObjTypeReverseProc	BAReverse;
static Tcl_ObjTypeGetElements	BAGetElements;
static Tcl_ObjTypeSetElement	BASetElement;
static Tcl_ObjTypeReplaceProc	BAReplace;
static Tcl_ObjTypeInOperatorProc BAInOper;
static Tcl_FreeInternalRepProc	BAFree;
static Tcl_DupInternalRepProc	BADup;
static Tcl_UpdateStringProc	BAUpdateString;

static const Tcl_ObjType bitarrayType = {
    "bitarray", BAFree, BADup, BAUpdateString, NULL,
    TCL_OBJTYPE_V2(BALength, BAIndex, BASlice, BAReverse, BAGetElements,
	    BASetElement, BAReplace, BAInOper)
};

#define GETREP(o)	((BitArr *)(o)->internalRep.twoPtrValue.ptr1)
#define ISBA(o)		((o)->typePtr == &bitarrayType)
#define GETBIT(b,i)	(((b)->words[(i) >> 6] >> ((i) & 31)) & 1)        /* M01 changed:constant | CAUGHT by 5: diff-1.1 grow-1.3 diff-3.1 diff-2.1 diff-4.2 | GETBIT shift mask 63->31 | line 122 */
#define SETBIT(b,i)	((b)->words[(i) >> 6] ^= (uint64_t)1 << ((i) & 63))
                                                                          /* M02 changed:operator | CAUGHT by 5: repl-1.1 diff-1.1 diff-3.1 diff-2.1 diff-4.2 | SETBIT or -> xor | line 123 */
#define CLRBIT(b,i)	((b)->words[(i) >> 6] &= ((uint64_t)1 << ((i) & 63)))
                                                                          /* M03 deleted:clause | CAUGHT by 21: set-1.4 set-1.11 repl-1.1 repl-1.3 iter-1.2 fill-w.4 fill-w.5 fill-w.6 fill-w.7 fill-w.8 fill-w.9 big-1.1 diff-1.1 grow-1.1 grow-1.2 grow-1.3 grow-1.4 grow-1.5 diff-3.1 diff-2.1 diff-4.2 | CLRBIT loses ~ | line 124 */
#define BYTES(b)	((unsigned char *)(b)->words)
#define EBYTES(b)	((size_t)(b)->width / 8)    /* width > 1 only */

/* Words needed for LEN elements of WIDTH bits (caller has range-checked). */
#define WORDS_FOR(len, width) \
	((Tcl_Size)(((Tcl_WideInt)(len) * (width) + 62) / 64))            /* W16 changed:constant | CAUGHT (crash rc=-11 while running diff-3.1) + failed: diff-1.1 grow-1.5 | WORDS_FOR rounds down by one | line 130 */

/* ---------------------------------------------------------------- */

/*
 * Read or write element I.  The value is the raw unsigned bit pattern; for
 * width 64 the caller reinterprets it as signed.  Multi-byte elements go
 * through memcpy, which compilers turn into a single load or store and which
 * avoids strict-aliasing and alignment problems.
 */
static uint64_t
GetElem(const BitArr *b, Tcl_Size i)
{
    const unsigned char *p = (const unsigned char *)b->words;

    if (b->width == 1) return GETBIT(b, i);
    switch (b->width) {
    case 8:  return p[i];
    case 16: { uint16_t v; memcpy(&v, p + 3 * (size_t)i, 2); return v; }
                                                                          /* W01 changed:constant | CAUGHT by 9: range-16.1 elem-1.4 elem-1.7 elem-1.10 elem-1.11 bulk-16.1 bulk-16.2 bulk-w.2 diff-4.1 | GetElem 16 wrong offset | line 148 */
    case 32: { uint32_t v; memcpy(&v, p + 2 * (size_t)i, 4); return v; }
                                                                          /* W02 changed:constant | CAUGHT by 5: range-32.1 elem-1.4 elem-1.9 bulk-32.1 diff-4.1 | GetElem 32 wrong offset | line 149 */
    case 64: { uint64_t v; memcpy(&v, p + 4 * (size_t)i, 8); return v; }
                                                                          /* W03 changed:constant | CAUGHT by 8: fill-w.11 range-64.1 elem-1.4 elem-1.15 elem-1.19 bulk-64.1 bulk-64.2 diff-4.1 | GetElem 64 wrong offset | line 150 */
    default: return GETBIT(b, i);
    }
}

static void
PutElem(BitArr *b, Tcl_Size i, uint64_t val)
{
    unsigned char *p = BYTES(b);

    if (b->width == 1) {
	if (val) SETBIT(b, i); else CLRBIT(b, i);
	return;
    }
    switch (b->width) {
    case 8:  p[i] |= (unsigned char)val; break;                           /* W04 changed:+tokens | CAUGHT by 2: elem-1.12 diff-4.1 | PutElem 8 ORs instead of assigns | line 165 */
    case 16: { uint16_t v = (uint16_t)val; memcpy(p + 3 * (size_t)i, &v, 2); break; }
                                                                          /* W05 changed:constant | CAUGHT (crash rc=-11 while running diff-4.1) + failed: range-16.1 elem-1.4 elem-1.7 elem-1.10 elem-1.11 bulk-16.1 bulk-16.2 bulk-w.2 | PutElem 16 wrong offset | line 166 */
    case 32: { uint32_t v = (uint32_t)val; memcpy(p + 2 * (size_t)i, &v, 4); break; }
                                                                          /* W06 changed:constant | CAUGHT by 5: range-32.1 elem-1.4 elem-1.9 bulk-32.1 diff-4.1 | PutElem 32 wrong offset | line 167 */
    case 64: memcpy(p + 4 * (size_t)i, &val, 8); break;                   /* W07 changed:constant | CAUGHT by 10: fill-w.11 range-64.1 elem-1.2 elem-1.4 elem-1.15 elem-1.18 elem-1.19 bulk-64.1 bulk-64.2 diff-4.1 | PutElem 64 wrong offset | line 168 */
    default: if (val) SETBIT(b, i); else CLRBIT(b, i); break;
    }
}

static BitArr *
NewRep(Tcl_Interp *interp, Tcl_Size len, int width)
{
    Tcl_Size nwords;
    size_t bytes;
    BitArr *b;

    if (len < 0 || (Tcl_WideInt)len > BA_MAX_BITS) {                      /* W14 deleted:clause | MISSED by all 184 tests | NewRep limit ignores width | line 180 */
	if (interp) {
	    Tcl_SetObjResult(interp, Tcl_NewStringObj(
		    "bitarray size out of range", -1));
	    Tcl_SetErrorCode(interp, "TCL", "VALUE", "SIZE", NULL);
	}
	return NULL;
    }
    nwords = (len + 63) / 64;                                             /* W15 changed:expression | CAUGHT (crash rc=-4 while running bulk-32.1) + failed: range-64.1 elem-1.9 elem-1.15 elem-1.19 bulk-8.2 bulk-8.5 bulk-8.6 | NewRep allocates for 1-bit only | line 188 */
    bytes = sizeof(BitArr) + (nwords ? nwords - 1 : 0) * sizeof(uint64_t);
    b = (BitArr *)Tcl_AttemptAlloc(bytes);
    if (b == NULL) {
	if (interp) {
	    Tcl_SetObjResult(interp, Tcl_NewStringObj("out of memory", -1));
	    Tcl_SetErrorCode(interp, "TCL", "MEMORY", NULL);
	}
	return NULL;
    }
                                                                          /* M28 deleted:statement | CAUGHT (crash rc=-4 while running new-1.2) + failed: new-1.1 | new: no memset | line 198 */
    b->len = len;
    b->nwords = nwords;
    b->capWords = nwords;
    b->width = width;
    b->zero = Tcl_NewWideIntObj(0);
    b->one = Tcl_NewWideIntObj(1);
    Tcl_IncrRefCount(b->zero);
    Tcl_IncrRefCount(b->one);
    return b;
}

static void
FreeElems(BitArr *b)
{
    if (b->elems) {
	if (0) {                                                          /* W17 changed:expression | CAUGHT by 1: mem-1.1 | FreeElems never releases owned elements | line 214-215 */
	    Tcl_Size i;

	    /* Entries other than the shared 0/1 objects are owned by us. */
	    for (i = 0; i < b->elemsLen; i++) {
		if (1) {                                                  /* W18 changed:expression | CAUGHT (crash rc=-11 while running elem-1.16) | FreeElems also releases shared 0/1 | line 219 */
		    Tcl_DecrRefCount(b->elems[i]);
		}
	    }
	}
	Tcl_Free(b->elems);
	b->elems = NULL;
	b->elemsLen = 0;
    }
}

static void
FreeRep(BitArr *b)
{
    FreeElems(b);
    Tcl_DecrRefCount(b->zero);
    Tcl_DecrRefCount(b->one);
    Tcl_Free(b);
}

static Tcl_Obj *
WrapRep(BitArr *b)
{
    Tcl_Obj *obj = Tcl_NewObj();
    Tcl_ObjInternalRep ir;

    Tcl_InvalidateStringRep(obj);
    ir.twoPtrValue.ptr1 = b;
    ir.twoPtrValue.ptr2 = NULL;
    Tcl_StoreInternalRep(obj, &bitarrayType, &ir);
    return obj;
}

static void
Touch(Tcl_Obj *obj)
{
    FreeElems(GETREP(obj));
                                                                          /* M12 deleted:clause | CAUGHT by 1: diff-1.1 | Touch keeps string rep | line 255-256 | version 1 of 2 on these lines */
                                                                          /* M13 deleted:clause | CAUGHT by 5: diff-1.1 diff-3.1 diff-2.1 diff-4.1 diff-4.2 | Touch keeps element cache | line 255-256 | version 2 of 2 on these lines */
    Tcl_InvalidateStringRep(obj);
}

/* Element VAL as a Tcl value (new object, reference count 0, unless 0 or 1). */
static Tcl_Obj *
ElemObj(const BitArr *b, uint64_t val)
{
    if (val == 0) return b->zero;
    if (val == 1) return b->zero;                                         /* W09 changed:name/variable | CAUGHT by 2: elem-1.1 diff-4.1 | ElemObj 1 returns zero | line 264 */
    return Tcl_NewWideIntObj(b->width == 32 ? (Tcl_WideInt)(int64_t)val   /* W08 changed:constant | MISSED by all 184 tests | ElemObj sign only for 32 | line 265 */
	    : (Tcl_WideInt)val);
}

static void
SetRangeOnes(BitArr *b, Tcl_Size first, Tcl_Size last, int val)
{
    Tcl_Size fw = first >> 6, lw = last >> 6, i;
    uint64_t fm = ~(uint64_t)0 << (first & 63);
    uint64_t lm = ~(uint64_t)0 >> (63 - (last & 63));

    if (fw == lw) {
	if (val) b->words[fw] |= fm; else b->words[fw] &= ~fm;            /* M21 deleted:clause | CAUGHT by 9: fill-1.4 fill-1.13 fill-w.1 fill-w.2 fill-w.3 fill-w.22 fill-w.24 diff-2.1 diff-4.2 | fill single-word mask | line 277 */
	return;
    }
    if (val) b->words[fw] |= fm; else b->words[fw] &= ~fm;
    for (i = fw + 1; i <= lw; i++) {                                      /* M22 changed:operator | CAUGHT by 3: fill-1.1 diff-2.1 diff-4.2 | fill middle loop <= | line 281-282 */
	b->words[i] = val ? ~(uint64_t)0 : 0;
    }
    if (val) b->words[lw] |= lm; else b->words[lw] &= ~lm;
}

static Tcl_WideInt
CountRange(BitArr *b, Tcl_Size first, Tcl_Size last)
{
    Tcl_Size fw, lw, i;
    uint64_t fm, lm;
    Tcl_WideInt total;

    if (first > last) return 0;
    fw = first >> 6; lw = last >> 6;
    fm = ~(uint64_t)0 << ((first + 1) & 63);                              /* M17 changed:+tokens | CAUGHT by 18: new-1.7 set-1.10 range-1.1 rev-1.2 in-1.2 count-1.1 count-w.1 count-w.3 count-w.5 count-w.6 count-w.9 diff-1.1 grow-1.1 grow-1.5 diff-3.1 diff-2.1 bulk-1.9 diff-4.2 | count first mask | line 296-299 | version 1 of 2 on these lines */
    lm = ~(uint64_t)0 >> (63 - (last & 63));
    if (fw == lw) {
	return BA_POPCOUNT(b->words[fw] & fm & lm);
    fm = ~(uint64_t)0 << (first & 63);
    lm = ~(uint64_t)0 >> (62 - (last & 63));                              /* M18 changed:constant | CAUGHT by 12: new-1.7 range-1.1 count-1.1 count-w.5 count-w.6 big-1.1 diff-1.1 grow-1.4 diff-3.1 diff-2.1 bulk-1.9 diff-4.2 | count last mask | line 297-299 | version 2 of 2 on these lines */
    if (fw == lw) {
	return BA_POPCOUNT(b->words[fw] & fm & lm);
    }
    total = BA_POPCOUNT(b->words[fw] & fm);
    for (i = fw + 1; i < lw; i++) {
	total += BA_POPCOUNT(b->words[i]);
    }
    return total + BA_POPCOUNT(b->words[lw] & lm);
}

static Tcl_Size
NextBit(BitArr *b, Tcl_Size start, int val)
{
    Tcl_Size w;
    uint64_t cur;

    if (start < 0) start = 0;
    if (start >= b->len) return -1;
    w = start >> 6;
    cur = (val ? b->words[w] : ~b->words[w]) & ~(uint64_t)0;              /* M19 deleted:clause | CAUGHT by 8: next-1.1 next-w.1 next-w.2 next-w.3 diff-1.1 grow-1.1 diff-2.1 diff-4.2 | next start mask removed | line 317 */
    for (;;) {
	if (cur) {
	    Tcl_Size idx = (w << 6) + BA_CTZ(cur);
	    return idx;                                                   /* M20 deleted:clause | CAUGHT by 7: rev-1.2 next-1.2 next-w.3 diff-1.1 diff-3.1 diff-2.1 diff-4.2 | next tail check removed | line 321 */
	}
	if (++w >= b->nwords) return -1;
	cur = val ? b->words[w] : ~b->words[w];
    }
}

/*
 * Counting and searching for widths above 1.  ANYNZ means "any non-zero
 * element"; otherwise elements equal to VAL (a raw bit pattern).
 */
static Tcl_WideInt
CountWide(const BitArr *b, Tcl_Size first, Tcl_Size last, int anyNZ,
	uint64_t val)
{
    Tcl_WideInt total = 0;
    Tcl_Size i;

    if (first > last) return 0;
    if (b->width == 8) {
	const unsigned char *p = (const unsigned char *)b->words;

	if (anyNZ) {
	    for (i = first; i <= last; i++) total += (p[i] == 0);         /* W31 changed:operator | CAUGHT by 3: bulk-8.1 bulk-8.4 diff-4.1 | CountWide 8-bit nonzero inverted | line 344 */
	} else {
	    unsigned char c = (unsigned char)val;

	    for (i = first; i <= last; i++) total += (p[i] != c);         /* W32 changed:operator | CAUGHT by 3: count-w.8 bulk-8.4 diff-4.1 | CountWide 8-bit equal inverted | line 348 */
	}
	return total;
    }
    for (i = first; i <= last; i++) {
	uint64_t e = GetElem(b, i);

	total += anyNZ ? (e == 0) : (e == val);                           /* W33 changed:operator | CAUGHT by 2: bulk-16.2 diff-4.1 | CountWide generic nonzero inverted | line 355 */
    }
    return total;
}

static Tcl_Size
NextWide(const BitArr *b, Tcl_Size start, int anyNZ, uint64_t val)
{
    Tcl_Size i;

    if (start < 0) start = 0;
    if (start >= b->len) return -1;
    if (b->width == 8) {
	const unsigned char *p = (const unsigned char *)b->words;

	if (!anyNZ) {
	    const unsigned char *q = (const unsigned char *)memchr(p + start,
		    (int)val, (size_t)(b->len - start + 1));              /* W34 changed:+tokens | CAUGHT by 1: diff-4.1 | NextWide memchr reads one byte too many | line 372 */

	    return q ? (Tcl_Size)(q - p) : -1;
	}
	i = start;
	for (; i < b->len && (i & 7); i++) {
	    if (p[i]) return i;
	}
	for (; i + 8 <= b->len; i += 8) {
	    uint64_t w;

	    memcpy(&w, p + i, 8);
	    ;                                                             /* W35 deleted:clause | CAUGHT by 3: bulk-8.1 bulk-8.5 diff-4.1 | NextWide word skip never stops | line 384 */
	}
	for (; i < b->len; i++) {
	    if (p[i]) return i;
	}
	return -1;
    }
    for (i = start; i < b->len; i++) {
	uint64_t e = GetElem(b, i);

	if (anyNZ ? (e != 0) : (e != val)) return i;                      /* W36 changed:operator | CAUGHT by 4: elem-1.18 bulk-16.2 bulk-64.1 diff-4.1 | NextWide generic compares wrong | line 394 */
    }
    return -1;
}

static int
ParseBit(Tcl_Interp *interp, Tcl_Obj *obj, int *bitPtr)
{
    Tcl_WideInt v;

    /* Fast path: a literal 0 or 1 that already has a string representation. */
    if (obj->bytes != NULL && obj->length >= 1                            /* M25 changed:operator | CAUGHT by 1: set-1.11 | ParseBit fast path accepts longer | line 405-406 */
	    && (obj->bytes[0] == '0' || obj->bytes[0] == '1')) {
	*bitPtr = obj->bytes[0] - '0';
	return TCL_OK;
    }
    if (Tcl_GetWideIntFromObj(NULL, obj, &v) != TCL_OK || (v != 0 && v != 1)) {
	if (interp) {
	    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		    "expected 0 or 1 but got \"%s\"", Tcl_GetString(obj)));
	    Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	}
	return TCL_ERROR;
    }
    *bitPtr = (int)v;
    return TCL_OK;
}

/*
 * Parse an element value for an array of WIDTH bits into its raw bit pattern.
 * Widths 8, 16 and 32 are unsigned; width 64 is signed.
 */
static int
ParseValue(Tcl_Interp *interp, Tcl_Obj *obj, int width, uint64_t *vp)
{
    Tcl_WideInt v;

    if (width == 1) {
	int bit;

	if (ParseBit(interp, obj, &bit) != TCL_OK) return TCL_ERROR;
	*vp = (uint64_t)bit;
	return TCL_OK;
    }
    if (obj->bytes != NULL && obj->length == 1
	    && obj->bytes[0] >= '0' && obj->bytes[0] <= 'z') {            /* W13 changed:token | CAUGHT by 1: range-8.4 | ParseValue digit fast path too wide | line 439 */
	*vp = (uint64_t)(obj->bytes[0] - '0');
	return TCL_OK;
    }
    if (Tcl_GetWideIntFromObj(NULL, obj, &v) == TCL_OK) {
	if (width == 99) {                                                /* W12 changed:constant | CAUGHT by 11: fill-w.11 range-64.1 elem-1.2 elem-1.4 elem-1.15 elem-1.18 elem-1.19 bulk-64.1 bulk-64.2 diff-4.1 mem-1.1 | ParseValue 64-bit path skipped | line 444-445 */
	    *vp = (uint64_t)v;
	    return TCL_OK;
	}
	if (v >= 0 && v <= (Tcl_WideInt)(((uint64_t)1 << width))) {       /* W10 deleted:clause | CAUGHT by 6: range-8.2 range-16.2 range-32.2 elem-1.5 elem-1.13 bulk-8.3 | ParseValue upper bound off by one | line 448 | version 1 of 2 on these lines */
	if (v >= -1 && v <= (Tcl_WideInt)(((uint64_t)1 << width) - 1)) {
                                                                          /* W11 changed:expression | CAUGHT by 1: range-8.3 | ParseValue accepts -1 | line 448 | version 2 of 2 on these lines */
	    *vp = (uint64_t)v;
	    return TCL_OK;
	}
    }
    if (interp) {
	if (width == 64) {
	    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		    "expected integer in range -9223372036854775808..9223372036854775807"
		    " but got \"%s\"", Tcl_GetString(obj)));
	} else {
	    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		    "expected integer in range 0..%lld but got \"%s\"",
		    (long long)(((uint64_t)1 << width) - 1), Tcl_GetString(obj)));
	}
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
    }
    return TCL_ERROR;
}

static void
IndexError(Tcl_Interp *interp, Tcl_Obj *idxObj)
{
    if (interp) {
	Tcl_SetObjResult(interp, Tcl_ObjPrintf("index \"%s\" out of range",
		Tcl_GetString(idxObj)));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "INDEX", "OUTOFRANGE", NULL);
    }
}

/* ------------------------- type hooks ----------------------------- */

static void
BAFree(Tcl_Obj *objPtr)
{
    FreeRep(GETREP(objPtr));
    objPtr->typePtr = NULL;
}

static void
BADup(Tcl_Obj *srcPtr, Tcl_Obj *copyPtr)
{
    BitArr *s = GETREP(srcPtr), *d = NewRep(NULL, s->len, 1);             /* W49 changed:expression | CAUGHT (crash rc=-11 while running diff-4.1) + failed: width-1.14 elem-1.9 elem-1.12 elem-1.14 elem-1.15 elem-1.19 bulk-w.1 | dup loses width | line 490 */
    Tcl_ObjInternalRep ir;

    if (d == NULL) Tcl_Panic("bitarray: out of memory in dup");
    memcpy(d->words, s->words, (size_t)(s->nwords > 1 ? s->nwords - 1 : s->nwords) * sizeof(uint64_t));
                                                                          /* M27 changed:+tokens | CAUGHT by 7: diff-1.1 grow-1.3 diff-3.1 elem-1.9 elem-1.19 diff-4.1 diff-4.2 | dup copies one word short | line 494 */
    ir.twoPtrValue.ptr1 = d;
    ir.twoPtrValue.ptr2 = NULL;
    Tcl_StoreInternalRep(copyPtr, &bitarrayType, &ir);
}

static void
BAUpdateString(Tcl_Obj *objPtr)
{
    BitArr *b = GETREP(objPtr);
    char *p;
    Tcl_Size i;

    if (b->len == 0) {
	Tcl_InitStringRep(objPtr, NULL, 0);
	return;
    }
    if (b->width == 1) {
	p = Tcl_InitStringRep(objPtr, NULL, 2 * b->len - 1);
	if (p == NULL) Tcl_Panic("bitarray: out of memory in string rep");
	for (i = 0; i < b->len; i++) {
	    *p++ = (char)('0' + GETBIT(b, i));
	    if (i + 1 < b->len) *p++ = ',';                               /* M26 changed:token | CAUGHT by 38: new-1.1 new-1.2 from-1.1 set-1.1 set-1.2 set-1.3 set-1.4 range-1.2 range-1.3 set-1.11 rev-1.1 repl-1.1 repl-1.3 iter-1.2 fill-1.2 fill-1.3 fill-1.4 fill-1.5 fill-1.6 fill-1.12 fill-1.14 fill-1.13 fill-w.1 fill-w.2 fill-w.3 fill-w.4 fill-w.5 fill-w.6 fill-w.7 fill-w.8 fill-w.9 fill-w.22 fill-w.24 fill-w.25 misc-1.2 misc-1.3 diff-1.1 grow-1.2 | string rep separator | line 516 */
	}
    } else {
	Tcl_DString ds;
	char buf[32];
	int n;

	Tcl_DStringInit(&ds);
	for (i = 0; i < b->len; i++) {
	    uint64_t v = GetElem(b, i);

	    if (i) Tcl_DStringAppend(&ds, ",", 1);                        /* W28 changed:token | CAUGHT by 27: fill-w.10 fill-w.11 width-1.3 width-1.4 width-1.5 width-1.11 range-8.1 range-16.1 range-32.1 range-64.1 range-x.1 elem-1.4 elem-1.6 elem-1.7 elem-1.9 elem-1.10 elem-1.11 elem-1.12 elem-1.13 elem-1.14 bulk-8.1 bulk-8.2 bulk-16.1 bulk-64.1 bulk-64.2 bulk-w.1 bulk-w.2 | string rep wrong separator (wide) | line 527 */
	    if (b->width == 64) {
		n = snprintf(buf, sizeof(buf), "%llu", (unsigned long long)v);
                                                                          /* W27 changed:expression | CAUGHT by 4: fill-w.11 range-64.1 bulk-64.1 bulk-64.2 | string rep 64-bit printed unsigned | line 529 */
	    } else {
		n = snprintf(buf, sizeof(buf), "%llu", (unsigned long long)v);
	    }
	    Tcl_DStringAppend(&ds, buf, n);
	}
	Tcl_InitStringRep(objPtr, Tcl_DStringValue(&ds),
		(Tcl_Size)Tcl_DStringLength(&ds));
	Tcl_DStringFree(&ds);
    }
}

static Tcl_Size
BALength(Tcl_Obj *objPtr)
{
    return GETREP(objPtr)->len;
}

static int
BAIndex(Tcl_Interp *interp, Tcl_Obj *objPtr, Tcl_Size index, Tcl_Obj **elemPtr)
{
    BitArr *b = GETREP(objPtr);

    (void)interp;
    if (index < 0 || index > b->len) {                                    /* M05 changed:operator | CAUGHT by 2: diff-1.1 elem-1.1 | index bound > for >= | line 553-554 */
	*elemPtr = NULL;
    } else if (b->width == 1) {
	*elemPtr = GETBIT(b, index) ? b->one : b->zero; } else if (index == b->len - 1) { *elemPtr = b->zero;
                                                                          /* W53 added:code | CAUGHT by 4: elem-1.1 elem-1.3 elem-1.19 diff-4.1 | index out of range for wide returns last | line 555-557 */
    } else {
	*elemPtr = ElemObj(b, GetElem(b, index));
    }
    return TCL_OK;
}

static int
BASlice(Tcl_Interp *interp, Tcl_Obj *objPtr, Tcl_Size from, Tcl_Size to,
	Tcl_Obj **newObjPtr)
{
