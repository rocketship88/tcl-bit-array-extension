	}
	Touch(work);              // string form and element cache are out of date
	Tcl_IncrRefCount(work);   // keep it alive until the variable has it
	obj = Tcl_ObjSetVar2(interp, objv[2], NULL, work, TCL_LEAVE_ERR_MSG);
	Tcl_DecrRefCount(work);
	return obj ? TCL_OK : TCL_ERROR;

      fillUsage:
	Tcl_WrongNumArgs(interp, 2, objv,
		"varName first ?to? last ?with? value ?by? ?step?");
	return TCL_ERROR;
    }
    }
    return TCL_OK;   // not reached: every case returns                                             /* I04 changed:expression | MISSED by all 28 tests | BitarrayCmd: the impossible check at the end does nothing | line 2048 */
}

#ifdef BA_TEST
/* Test build only: "bitarray_test maxbits N" sets the size limit, "bitarray_test failalloc K" makes one allocation fail,
 * "bitarray_test getelem W" / "putelem W" call GetElem / PutElem with the width W (to run the BA_IMPOSSIBLE panics). */
#ifdef BA_GCOV
extern void __gcov_dump(void);   // only when built with --coverage -DBA_GCOV (extras/coverage.sh)
#endif
static void baAbort(int sig)
{
#ifdef BA_GCOV
    __gcov_dump();   // the coverage counts of this process would be lost otherwise
#endif
    _exit(128 + sig);
}
static int
BitarrayTestCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
{
    Tcl_WideInt w;
    Tcl_WideInt times = 1;

    (void)cd;

    const char *cmd = objc > 1 ? Tcl_GetString(objv[1]) : "";

    if ((objc != 3 && objc != 4) || Tcl_GetWideIntFromObj(interp, objv[2], &w) != TCL_OK
	    || (objc == 4 && Tcl_GetWideIntFromObj(interp, objv[3], &times) != TCL_OK)
	    || (strcmp(cmd, "maxbits") && strcmp(cmd, "failalloc") && strcmp(cmd, "getelem") && strcmp(cmd, "putelem"))) {
	Tcl_WrongNumArgs(interp, 1, objv, "maxbits N | failalloc K ?times? | getelem WIDTH | putelem WIDTH");
	return TCL_ERROR;
    }
    if (strcmp(cmd, "maxbits") == 0) {
	baTestMax = w;
    } else if (strcmp(cmd, "failalloc") == 0) {
	baFailAfter = (int)w;
	baFailCount = (int)times;
    } else {   // getelem / putelem: call GetElem / PutElem on an array whose width has been changed to WIDTH
	BitArr *b = NewRep(interp, 4, 8, 0);

	if (b == NULL) {
	    return TCL_ERROR;   // fi-6.6: "failalloc 0" first makes this allocation fail
	}
	b->width = (unsigned char)w;
	if (strcmp(cmd, "getelem") == 0) {
	    (void)GetElem(b, 0);
	} else {
	    PutElem(b, 0, 1);
	}
	b->width = 8;
	FreeRep(b);
    }
    return TCL_OK;
}
#endif

DLLEXPORT int
Bitarray_Init(Tcl_Interp *interp)
{
    if (Tcl_InitStubs(interp, "9.1", 0) == NULL) {                // Tcl 9.1 or newer: the abstract-list hooks need it
        return TCL_ERROR;   // not reached: only a Tcl older than 9.1 gets here
    }
    Tcl_CreateObjCommand2(interp, "bitarray", BitarrayCmd, NULL, NULL);   // the Tcl_Size (64-bit) form of the command procedure
#ifdef BA_TEST
    Tcl_CreateObjCommand2(interp, "bitarray_test", BitarrayTestCmd, NULL, NULL);   // test build only
    signal(SIGABRT, baAbort);   // Tcl_Panic kills the process (SIGILL or SIGABRT): save the coverage counts first
    signal(SIGILL, baAbort);
    signal(SIGSEGV, baAbort);
#endif
    return Tcl_PkgProvide(interp, "bitarray", BA_VERSION);
}
