	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
		"bitarray %s: arrays differ in width (%d vs %d)",
		name, SignedWidth(x), SignedWidth(y)));
	Tcl_SetErrorCode(interp, "TCL", "VALUE", "BITARRAY", NULL);
	return TCL_ERROR;
    }
    if (x->len != y->len) {   // lengths must match unless -length zero                             /* B15 deleted:clause | CAUGHT by 2: bitop-1.4 bitop-2.7 | length check ignores -length zero | line 1432 | version 1 of 2 on these lines */
