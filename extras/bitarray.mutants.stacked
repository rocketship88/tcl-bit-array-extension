		(Tcl_Size)Tcl_DStringLength(&ds));
	Tcl_DStringFree(&ds);
    }
}

static Tcl_Size
BALength(Tcl_Obj *objPtr)
{
    return GETREP(objPtr)->len;
}

static int
BAIndex(Tcl_Interp *interp, Tcl_Obj *objPtr, Tcl_Size index, Tcl_Obj **elemPtr)
